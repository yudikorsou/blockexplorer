# ---------- the package sorting page: how your node fills the block it would build ----------
# Bitcoin Core builds a block template from packages: a transaction is taken together with the unconfirmed parents it needs (child pays for parent),
# a package is ranked by the fee rate of the whole, and the best packages fill the block first. All of it is read from your node's getblocktemplate
# ("depends" tells which transactions of the template another one needs) and the size of its mempool.

def _step(n, title, cap, body, cls):
    return ("<div class='bast " + cls + "'><span class=ban>" + n + "</span><div class=batt><b>" + title + "</b><em>" + cap + "</em></div><div class=bastb>" + body + "</div></div>")


def package_parts():
    d = block_template()
    t = TEMPLATE.get("raw") or {}
    txs = t.get("transactions", [])
    n = len(txs)
    vs = [max(1, (int(x.get("weight", 0)) + 3) // 4) for x in txs]
    fee = [int(x.get("fee", 0)) for x in txs]
    deps = [[int(i) - 1 for i in x.get("depends", []) if 0 < int(i) <= n] for x in txs]
    anc_cache = {}

    def ancestors(i):
        if i in anc_cache:
            return anc_cache[i]
        seen, stack = set(), list(deps[i])
        while stack:
            j = stack.pop()
            if j not in seen:
                seen.add(j)
                stack.extend(deps[j])
        anc_cache[i] = seen
        return seen
    pk = []                                   # per transaction of the template: (package fee rate, transactions in the package, own fee rate, fee rate of its parents)
    for i in range(n):
        a = ancestors(i) if deps[i] else set()
        pf, pv = fee[i] + sum(fee[j] for j in a), vs[i] + sum(vs[j] for j in a)
        af, av = sum(fee[j] for j in a), sum(vs[j] for j in a)
        pk.append((pf / pv, 1 + len(a), fee[i] / vs[i], (af / av) if av else 0.0))
    with_parents = [i for i in range(n) if deps[i]]
    # the clearest child-pays-for-parent packages: the parents alone pay much less than the whole package
    boosted = sorted((i for i in with_parents if pk[i][3] and pk[i][0] > pk[i][3] * 1.25), key=lambda i: -pk[i][0])
    ex, seen_pairs = [], set()
    for i in boosted:
        key = (round(pk[i][3], 1), round(pk[i][2], 1))
        if key not in seen_pairs:
            seen_pairs.add(key)
            ex.append(i)
        if len(ex) == 3:
            break
    try:
        waiting = int(NODE.call("getmempoolinfo").get("size", 0))
    except Exception:  # noqa: BLE001
        waiting = n
    wused = int(d["weight"]) + 324
    wlimit = int(t.get("weightlimit", 4_000_000))
    wpct = "{:.1f}".format(wused / wlimit * 100)
    cut = min((pk[i][0] for i in range(n)), default=0.0)
    best = max((pk[i][0] for i in range(n)), default=0.0)
    chips = ("<span class=chip>Block being mined <b>" + "{:,}".format(d["height"]) + "</b></span><span class=chip><b>" + "{:,}".format(waiting) + "</b> waiting in your mempool</span>"
             "<span class=chip><b>" + "{:,}".format(n) + "</b> fit the next block</span>")
    rank = sorted(range(n), key=lambda i: (-pk[i][0], i))[:6]
    steps = (_step("1", "Look at the mempool", "your node keeps every transaction that is waiting for a block",
                   "<div class=babig>" + "{:,}".format(waiting) + " <small>transactions waiting</small></div><div class=basub>the next block has room for about " + "{:,}".format(n) + " of them</div>", "s1")
             + _step("2", "Group them into packages", "a transaction is taken together with the unconfirmed parents it needs, so a cheap parent can ride along with a child that pays well",
                     "<div class=babig>" + "{:,}".format(len(with_parents)) + " <small>of the " + "{:,}".format(n) + " have unconfirmed parents</small></div>"
                     , "s2")
             + _step("3", "Fill the block", "the best packages go in first until the block is full; the rest wait for the next one",
                     "<div class=basub>Weight " + "{:,}".format(wused) + " of " + "{:,}".format(wlimit) + " (" + wpct + "%)</div><div class=bafill><i style='width:" + wpct + "%'></i></div>"
                     "<div class=basub>The last package that fitted paid <b>" + "{:,.1f}".format(cut) + " sat/vB</b>: that is about what a transaction needs to pay to make the next block.</div>"
                     + ("<div class=basub>" + "{:,}".format(max(0, waiting - n)) + " transactions pay less and wait.</div>" if waiting > n else ""), "s4"))
    # what the animated block shows: the real child-pays-for-parent packages (parent, child, whole), then the best single transaction
    items = [{"lo": round(pk[i][3], 1), "hi": round(pk[i][2], 1), "rate": round(pk[i][0], 1)} for i in ex]
    if len(items) < 3:
        singles = [i for i in range(n) if not deps[i]]
        for i in sorted(singles, key=lambda i: -pk[i][0])[: 3 - len(items)]:
            items.append({"lo": None, "hi": round(pk[i][2], 1), "rate": round(pk[i][0], 1)})
    return {"chips": chips, "steps": steps, "items": items, "ntx": n, "waiting": waiting, "fill": round(wused / wlimit * 100, 1), "cut": round(cut, 1), "height": d["height"]}


