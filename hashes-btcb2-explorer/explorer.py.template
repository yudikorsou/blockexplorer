def auction_snapshot(items, blocks):
    """the mempool as the fee auction page shows it (items: (fee rate, vsize, fee, txid), best first; blocks: the projected blocks)"""
    n = len(items)
    bands, cum, k = [[0, 0, None] for _ in FA_BANDS], 0, 0
    for r, v, _, _ in items:
        while k < len(FA_BANDS) - 1 and r < FA_BANDS[k][0]:
            k += 1
        bands[k][0] += 1
        bands[k][1] += v
        if bands[k][2] is None:
            bands[k][2] = cum // 1_000_000 + 1
        cum += v
    first = blocks[0] if blocks else {"nTx": 0, "blockVSize": 0, "medianFee": 0, "feeRange": [0, 0, 0, 0, 0, 0, 0]}
    return {"at": int(time.time()), "n": n, "vsize": cum, "top": [(round(r, 1), v, round(b), t) for r, v, b, t in items[:8]],
            "bars": [round(items[int(i * (n - 1) / 6)][0], 1) for i in range(7)] if n >= 2 else [],
            "bands": [tuple(b) for b in bands],
            "b1": {"nTx": first["nTx"], "vsize": first["blockVSize"], "med": first["medianFee"], "lo": first["feeRange"][0], "hi": first["feeRange"][-1]}}


