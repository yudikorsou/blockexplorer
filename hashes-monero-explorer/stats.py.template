def assembly_parts():
    """the projected block as your node sees it, as the pieces of the Block assembly page that change"""
    d = block_template()
    kb = lambda v: "{:,.0f} kB".format(v / 1000.0)
    blob = bytes.fromhex(d["blob"])
    n_cnt = len(varint(d["nTx"]))
    fields = [("Major version", len(varint(d["majorVersion"])), str(d["majorVersion"]), "the consensus rules this block follows", "#4a78c9", "Version"),
              ("Minor version", len(varint(d["minorVersion"])), str(d["minorVersion"]), "a vote for the next network upgrade", "#4a78c9", "Version"),
              ("Timestamp", len(varint(d["timestamp"])), time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(d["timestamp"])) + " UTC", "when the block is made (unix time {:,}); the miner updates it as it works".format(d["timestamp"]), "#2fb585", "Time"),
              ("Previous block", 32, d["prevId"], "the hash of block {:,}: this is what chains the blocks together".format(d["height"] - 1), "#7a6cd6", "Previous block"),
              ("Nonce", 4, "00000000", "the number the miner changes on every try, until the hash is low enough", "#e8ebf5", "Nonce"),
              ("Merkle root", 32, d["merkleroot"], "one hash that stands for the miner transaction and all {:,} other transactions".format(d["nTx"] - 1), "#1bd8f4", "Merkle root"),
              ("Transaction count", n_cnt, str(d["nTx"]), "the miner transaction plus the transactions of the pool", "#9ad9e8", "Count")]
    off, rows, bar, hexs, legend, seen = 0, "", "", "", "", set()
    for name, size, val, why, col, grp in fields:
        chunk = blob[off:off + size].hex()
        span = str(off) if size == 1 else "{}–{}".format(off, off + size - 1)
        rows += ("<tr><td class=sw><i style='background:" + col + "'></i></td><td><b>" + name + "</b></td><td class=r>" + span + "</td><td class=r data-b='" + span + "'>" + str(size) + " B</td>"
                 "<td class='mono wrap'>" + esc(val) + "</td><td class=why>" + esc(why) + "</td></tr>")
        bar += "<i style='flex:" + str(size) + ";background:" + col + "' title='" + name + " · " + str(size) + " bytes'></i>"
        hexs += "<span style='color:" + col + "' title='" + name + "'>" + chunk + "</span>"
        if grp not in seen:
            seen.add(grp)
            n = sum(f[1] for f in fields if f[5] == grp)
            legend += "<span class=lg><i style='background:" + col + "'></i>" + grp + " <em>" + str(n) + " B</em></span>"
        off += size
    total = len(blob)
    base = TAIL_REWARD
    pen = penalty(d["weight"], d["median"]) * base
    got = base - pen + d["fees"]
    leaves = d["nTx"]
    levels = max(1, (leaves - 1).bit_length())
    pct = min(100, d["weight"] / d["median"] * 100)
    st = lambda n, title, cap, body, cls="": ("<div class='st " + cls + "'><span class=n>" + n + "</span><div class=stt><b>" + title + "</b><em>" + cap + "</em></div><div class=stb>" + body + "</div></div>")
    s1 = st("1", "Pick the transactions", "the best fee per byte that fit the block · <a href='/fee-ranking'>ranking</a>",
            "<div class=big2>" + "{:,}".format(leaves - 1) + " <small>transactions</small></div><div class=fill><i style='width:" + "{:.0f}".format(pct) + "%'></i></div><div class=sub>" + kb(d["weight"]) + " of the " + kb(d["median"]) + " median · fees " + xmr(d["fees"]) + " XMR</div>", "s1")
    s2 = st("2", "Fold them into a merkle root", "tree hash of " + "{:,}".format(leaves) + " hashes, the miner transaction first · " + str(levels) + " rounds",
            "<div class='big2 mono' title='" + esc(d["merkleroot"]) + "'>" + esc(d["merkleroot"][:12]) + "…" + esc(d["merkleroot"][-8:]) + "</div><div class=sub>" + "{:,}".format(leaves) + " hashes → 1 root</div>", "s2")
    s3 = st("3", "Add the miner transaction", "pays whoever finds the block · stand-in hash <span class=mono>" + esc(d["minerTx"][:6]) + "…</span> until a miner builds the real one",
            "<div class=big2>" + xmr(got) + " <small>XMR</small></div><div class=sub>" + xmr(base) + " base + " + xmr(d["fees"]) + " fees − " + (xmr(pen) if pen else "0") + " penalty · <a href='/block-size'>size penalty</a></div>", "s3")
    s4 = st("4", "Write the " + str(total) + "-byte header", "what every miner hashes, over and over, with a new nonce each time",
            "<div class=bytebar>" + bar + "</div><div class=legend2>" + legend + "</div>", "s4")
    steps = s1 + s2 + s3 + s4
    header = ("<div class=tbl><table class='rank fld'><tr><th></th><th>Field</th><th class=r>Byte</th><th class=r>Size</th><th>Value</th><th>What it is</th></tr>" + rows + "</table></div>"
              "<p class='mono hexblob'>" + hexs + "</p>")
    details = ("<details><summary>The header, field by field</summary>" + header + "</details>")
    chips = ("<span class=chip>Block being mined <b>" + "{:,}".format(d["height"]) + "</b></span><span class=chip>not mined yet</span>")
    segs, seen_g = [], {}
    for name, size, val, why, col, grp in fields:
        segs.append([size, col])
    return {"chips": chips, "steps": steps, "details": details, "height": d["height"], "root": d["merkleroot"], "ntx": leaves, "prev": d["prevId"], "weight": d["weight"], "median": d["median"],
            "got": got / 1e12, "fees": d["fees"] / 1e12, "ver": str(d["majorVersion"]) + "." + str(d["minorVersion"]), "total": total, "segs": segs}


