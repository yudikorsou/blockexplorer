"""

TAIL_EMISSION_HEIGHT = 2641623      # from here every block's base reward is the tail emission of 0.6 XMR: the rest of the reward is fees
TAIL_REWARD = 600_000_000_000


def xmr(atomic):
    return "{:.12f}".format(atomic / 1e12).rstrip("0").rstrip(".") or "0"


def esc(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&#39;")


def ago(ts):
    d = max(0, int(time.time()) - int(ts))
    return "{}s ago".format(d) if d < 60 else "{}m ago".format(d // 60) if d < 3600 else "{}h ago".format(d // 3600) if d < 86400 else "{}d ago".format(d // 86400)


def page(title, body, glass=False):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>" + esc(title) + " · Monero explorer</title>"
            "<style>" + PAGE_CSS + "</style></head><body" + (" class=g" if glass else "") + "><header><a class=brand href='/'>Monero <span>explorer</span></a>"
            "<form action='/search' method=get><input name=value placeholder='Block height, block hash or transaction hash' aria-label=Search><button>Search</button></form></header>"
            "<main>" + body + "</main><footer>Read from your own Monero node · hashes.space</footer></body></html>")


def block_page(ident):
    res = rpc("get_block", {"height": int(ident)} if ident.isdigit() else {"hash": ident.lower()})
    hd = res["block_header"]
    height = int(hd["height"])
    miner = json.loads(res["json"])["miner_tx"]
    payouts = max(1, len(miner.get("vout") or []))
    reward = int(hd["reward"])
    fees = reward - TAIL_REWARD if height >= TAIL_EMISSION_HEIGHT and reward >= TAIL_REWARD else None
    try:
        gap = int(hd["timestamp"]) - header_at(height - 1)[0] if height > 0 else None
    except Exception:
        gap = None
    depth = int(hd.get("depth", 0))
    stamp = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(int(hd["timestamp"])))

    def btn(href, label):
        return "<a href='" + href + "'>" + label + "</a>" if href else "<span class=off>" + label + "</span>"
    who = ("P2Pool · " + str(payouts) + " miners paid") if payouts > 1 else "a single payout (pool or solo)"
    head = ("<div class=bhero><h1>Block " + "{:,}".format(height) + "</h1><span class=chip>Paid to <b>" + who + "</b></span><span class=chip>" + stamp + " (" + ago(hd["timestamp"]) + ")</span>"
            "<span class=chip><b>" + "{:,}".format(depth) + "</b> confirmation" + ("" if depth == 1 else "s") + "</span>"
            "<div class=navbtns>" + btn("/block/" + hd["prev_hash"] if height > 0 else "", "← previous") + btn("/block/" + str(height + 1) if depth > 0 else "", "next →") + "</div></div>"
            "<div class=bhash><small>Block hash</small><span class=mono>" + esc(hd["hash"]) + "</span></div>")
    tiles = [("Transactions", "{:,}".format(int(hd["num_txes"])), ""), ("Reward", xmr(reward), "XMR" + (" · 0.6 base + fees" if fees is not None else "")),
             ("Fees", xmr(fees) if fees is not None else "-", "XMR"), ("Size", "{:,} B".format(int(hd["block_size"])), "{:,} B weight".format(int(hd.get("block_weight", hd["block_size"])))),
             ("Difficulty", "{:,}".format(int(hd["difficulty"])), "")]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:18px'>" + v + "</b>" + (("<em>" + sub + "</em>") if sub else "") + "</div>" for k, v, sub in tiles)
    mining = [("Miner reward tx", "<a class=mono href='/tx/" + esc(hd["miner_tx_hash"]) + "'>" + esc(hd["miner_tx_hash"]) + "</a>"), ("Payouts", str(payouts) + (" (P2Pool pays its miners in the block)" if payouts > 1 else " (a pool or a solo miner)")),
              ("Total reward", xmr(reward) + " XMR")] + ([("Block reward", "0.6 XMR"), ("Total fees", xmr(fees) + " XMR")] if fees is not None else [])
    header = [("Timestamp", stamp + " <span class=muted>(" + str(hd["timestamp"]) + ")</span>")] + ([("Since previous block", "{}:{:02d}:{:02d}".format(abs(gap) // 3600, abs(gap) % 3600 // 60, abs(gap) % 60))] if gap is not None else []) + [
              ("Version", "{}.{}".format(hd["major_version"], hd["minor_version"])), ("Nonce", "{:,}".format(int(hd["nonce"]))),
              ("Previous block", "<a class=mono href='/block/" + esc(hd["prev_hash"]) + "'>" + esc(hd["prev_hash"]) + "</a>")] + ([("PoW hash", "<span class=mono>" + esc(hd["pow_hash"]) + "</span>")] if hd.get("pow_hash") else [])
    gr = "".join("<section class=card><h2>" + t + "</h2><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in rows) + "</dl></section>" for t, rows in (("Mining", mining), ("Header", header)))
    return page("Block " + str(height), head + "<div class=tiles>" + tl + "</div><div class=groups>" + gr + "</div>")


def tx_page(txid):
    """a transaction in the same design: where it was mined, its figures as tiles, then details, inputs and outputs in cards"""
    out = NODE_RPC.post("/get_transactions", json.dumps({"txs_hashes": [txid.lower()], "decode_as_json": True}).encode(), 20)
    if not out.get("txs"):
        raise RuntimeError("transaction not found")
    t = out["txs"][0]
    tx = json.loads(t["as_json"])
    vin, vout = tx.get("vin") or [], tx.get("vout") or []
    coinbase = bool(vin) and "gen" in vin[0]
    rct = tx.get("rct_signatures") or {}
    fee = int(rct.get("txnFee") or 0)
    size = len(t.get("as_hex", "")) // 2
    extra = bytes(tx.get("extra") or [])
    pubkey = extra[1:33].hex() if len(extra) >= 33 and extra[0] == 1 else ""
    in_pool = bool(t.get("in_pool"))
    height = t.get("block_height")
    ts = t.get("block_timestamp")
    conf = int(t.get("confirmations") or 0)
    total = sum(int(o.get("amount") or 0) for o in vout)
    indices = t.get("output_indices") or [[]]
    indices = indices[0] if indices and isinstance(indices[0], list) else indices

    def key_of(o):
        tg = o.get("target") or {}
        k = tg.get("tagged_key") or tg.get("key") or ""
        return k.get("key", "") if isinstance(k, dict) else k

    kind = "Miner reward (coinbase)" if coinbase else "Transaction"
    chips = ("<span class=chip><b>" + kind + "</b></span>"
             + (("<span class=chip>In block <a href='/block/" + str(height) + "'><b>" + "{:,}".format(int(height)) + "</b></a></span>") if height is not None and not in_pool else "<span class=chip><b>Waiting in the mempool</b></span>")
             + (("<span class=chip>" + time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(int(ts))) + " (" + ago(ts) + ")</span>") if ts and not in_pool else "")
             + ("<span class=chip><b>" + "{:,}".format(conf) + "</b> confirmation" + ("" if conf == 1 else "s") + "</span>" if not in_pool else ""))
    head = ("<div class=bhero><h1>Transaction</h1>" + chips + "</div><div class=bhash><small>Transaction hash</small><span class=mono>" + esc(txid.lower()) + "</span></div>")
    tiles = [("Outputs", "{:,}".format(len(vout)), ""), ("Inputs", "{:,}".format(0 if coinbase else len(vin)), "newly created coins" if coinbase else "")]
    if coinbase:
        tiles.append(("Total out", xmr(total), "XMR"))
    else:
        tiles.append(("Fee", xmr(fee), "XMR"))
    tiles += [("Size", "{:,} B".format(size), ""), ("Version", str(tx.get("version", "")), "RingCT type " + str(rct.get("type", 0)))]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:18px'>" + v + "</b>" + (("<em>" + sub + "</em>") if sub else "") + "</div>" for k, v, sub in tiles)
    details = ([("Block", "<a href='/block/" + str(height) + "'>" + "{:,}".format(int(height)) + "</a>")] if height is not None and not in_pool else []) + [
        ("Version", str(tx.get("version", ""))), ("RingCT type", str(rct.get("type", 0))), ("Unlock time", "{:,}".format(int(tx.get("unlock_time") or 0)))] + (
        [("Fee", xmr(fee) + " XMR")] if not coinbase else []) + ([("Tx public key", "<span class=mono>" + pubkey + "</span>")] if pubkey else []) + [
        ("Extra", "<span class=mono>" + extra.hex() + "</span>")]
    if coinbase:
        ins = "<p class=muted>Newly created coins: the block reward" + (" of block " + "{:,}".format(int(vin[0]["gen"]["height"])) if isinstance(vin[0].get("gen"), dict) and "height" in vin[0]["gen"] else "") + ".</p>"
    else:
        ins = ("<table><tr><th>#</th><th>Key image</th><th class=r>Ring size</th></tr>" + "".join(
            "<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + esc((i.get("key") or {}).get("k_image", "")) + "</td><td class=r>" + str(len((i.get("key") or {}).get("key_offsets") or [])) + "</td></tr>" for n, i in enumerate(vin)) + "</table>")
    outs = ("<table><tr><th>#</th><th>Stealth address</th><th class=r>Amount</th><th class=r>Output index</th></tr>" + "".join(
        "<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + esc(key_of(o)) + "</td><td class=r>" + (xmr(int(o["amount"])) + " XMR" if int(o.get("amount") or 0) else "<span class=muted>hidden</span>") + "</td><td class=r>"
        + (("{:,}".format(indices[n])) if n < len(indices) else "") + "</td></tr>" for n, o in enumerate(vout)) + "</table>")
    body = (head + "<div class=tiles>" + tl + "</div><div class=groups><section class=card><h2>Details</h2><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in details) + "</dl></section></div>"
            "<section class=card><h2>" + ("Input" if coinbase else "Inputs (" + str(len(vin)) + ")") + "</h2>" + ins + "</section><section class=card><h2>Outputs (" + str(len(vout)) + ")</h2>" + outs + "</section>")
    return page("Transaction " + txid[:12], body)


def mst(n, title, cap, body, cls=""):
    return ("<div class='st " + cls + "'><span class=n>" + n + "</span><div class=stt><b>" + title + "</b><em>" + cap + "</em></div><div class=stb>" + body + "</div></div>")


def mstage(left, steps, h2, intro, caption=""):
    return ("<section class='card main cbstage'><div class=cbleft>" + left + ("<p class=cbcap>" + caption + "</p>" if caption else "") + "</div>"
            "<div class=cbright><h2>" + h2 + "</h2><p class=muted style='margin:0 0 12px'>" + intro + "</p><div class=sts id=steps>" + steps + "</div></div></section>")


def pgnav(here):
    names = [("/fee-ranking", "Fee-per-byte ranking"), ("/block-size", "Dynamic block size"), ("/block-assembly", "Block assembly"), ("/block-candidate", "Candidate block")]
    return "<nav class=pgnav>" + "".join("<a href='" + p + "'>" + n + "</a>" if p != here else "<span class=here>" + n + "</span>" for p, n in names) + "</nav>"


def ranking_parts():
    """the Fee-Per-Byte Ranking of the block that is being mined, as the pieces of the page that change: the node's pool of waiting transactions, from the highest fee rate down"""
    info = rpc("get_info")
    height = int(info["height"])
    pool = NODE_RPC.post("/get_transaction_pool", b"{}", 20).get("transactions") or []
    median = max(300000, int(info.get("block_weight_median") or info.get("block_size_median") or 0))
    rows = []
    for t in pool:
        if t.get("double_spend_seen") or t.get("do_not_relay"):
            continue
        w = max(1, int(t.get("weight") or t.get("blob_size") or 1))
        rows.append((int(t["fee"]) / w / 1000.0, int(t["fee"]), w, t["id_hash"]))   # nXMR per byte: 1 nXMR is 1000 piconero
    rows.sort(reverse=True)
    total = len(rows)
    used, fit = 0, 0
    for r in rows:
        if used + r[2] > median:
            break
        used += r[2]
        fit += 1
    rates = [r[0] for r in rows]
    top = rates[0] if rates else 0
    med = rates[len(rates) // 2] if rates else 0
    chips = ("<span class=chip>Block being mined <b>" + "{:,}".format(height) + "</b></span><span class=chip><b>" + "{:,}".format(total) + "</b> waiting</span>")
    tiles = [("Highest rate", "{:,.0f}".format(top), "nXMR/B"), ("Median rate", "{:,.0f}".format(med), "nXMR/B"), ("In the next block", "{:,}".format(fit), "of {:,} waiting".format(total)), ("Waiting after", "{:,}".format(total - fit), "for a later block")]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:20px'>" + v + "</b><em>" + sub + "</em></div>" for k, v, sub in tiles)

    def row(n, r):
        rate, fee, w, txid = r
        pct = max(3, int(rate / top * 100)) if top else 0
        return ("<tr class='" + ("in" if n < fit else "out") + "'><td class=n>" + str(n + 1) + "</td><td class=bar><div><span style='width:" + str(pct) + "%'></span><b>" + "{:,.0f}".format(rate) + "</b></div></td>"
                "<td class=r>" + xmr(fee) + "</td><td class=r>" + "{:,}".format(w) + "</td><td><a class=mono href='/tx/" + esc(txid) + "'>" + esc(txid[:6]) + "…" + esc(txid[-4:]) + "</a></td></tr>")
    th = "<tr><th>#</th><th>Fee rate (nXMR/B)</th><th class=r>Fee (XMR)</th><th class=r>Bytes</th><th>Tx</th></tr>"
    cut = "<tr class=cut><td colspan=5><span>Block full · " + "{:,}".format(used) + " of " + "{:,}".format(median) + " bytes · everything below waits</span></td></tr>"

    def lines(idx):
        out = []
        for n in idx:
            if n == fit and fit:
                out.append(cut)
            out.append(row(n, rows[n]))
        return "".join(out)
    first = list(range(min(8, total)))
    if fit > 8:
        gap = "<tr class=gap><td colspan=5><span>" + "{:,}".format(fit - 8) + " more in the block, down to " + "{:,.0f}".format(rates[fit - 1]) + " nXMR/B</span></td></tr>"
        short = lines(first) + gap + lines(list(range(fit - 1, min(fit + 3, total))))
    else:
        short = lines(list(range(min(fit + 3, total))))
    full = lines(list(range(min(total, 200))))
    table = ("<table class=rank>" + th + short + "</table>" + ("<details><summary>Show all " + "{:,}".format(total) + (" (first 200)" if total > 200 else "") + "</summary><table class=rank>" + th + full + "</table></details>" if total > 12 else "")
             if rows else "<p class=muted>No transactions are waiting right now: the next block is empty apart from its miner reward.</p>")
    unit = "nXMR/B"
    pool_kb = sum(r[2] for r in rows) / 1000.0
    steps = (mst("1", "Collect what waits", "the unconfirmed transactions in your node's pool",
                 "<div class=big2>" + "{:,}".format(total) + " <small>transactions</small></div><div class=sub>" + "{:,.1f}".format(pool_kb) + " kB waiting</div>", "s1")
             + mst("2", "Rate each one", "fee ÷ bytes: what it pays the miner for every byte it takes",
                   "<div class=big2>" + "{:,.0f}".format(top) + " <small>" + unit + " at the top</small></div><div class=sub>median " + "{:,.0f}".format(med) + " " + unit + "</div>", "s2")
             + mst("3", "Sort, best rate first", "the highest rate goes first, whatever its total fee",
                   "<div class=big2>#1 → #" + "{:,}".format(total) + "</div><div class=sub>" + ("the top rate is " + "{:,.0f}".format(top / med) + "× the median" if med else "nothing is waiting") + "</div>", "s3")
             + mst("4", "Fill the block", "from the top until the effective median (" + "{:,}".format(median) + " bytes) is reached",
                   "<div class=big2>" + "{:,}".format(fit) + " <small>of " + "{:,}".format(total) + " fit</small></div><div class=fill><i style='width:" + "{:.0f}".format(min(100, used / median * 100)) + "%'></i></div>"
                   "<div class=sub>" + "{:,.1f}".format(used / 1000.0) + " kB" + (" · about " + "{:,.0f}".format(rates[fit - 1]) + " " + unit + " gets in" if fit and total > fit else "") + "</div>", "s4"))
    n = len(rates)
    bars = [round(rates[int(i * (n - 1) / 6)], 1) for i in range(7)] if n >= 2 else []
    return {"chips": chips, "steps": steps, "bars": bars, "med": med, "tiles": tl, "height": height, "fit": fit, "used": used, "median": median, "total": total, "low": round(rates[fit - 1], 1) if fit else None}


_weights = {"tip": -1, "w": []}


def last_weights(tip):
    """the weights of the last 100 blocks, oldest first (cached until a block is found)"""
    if _weights["tip"] != tip:
        hs = rpc("get_block_headers_range", {"start_height": max(0, tip - 99), "end_height": tip})["headers"]
        _weights["w"] = [(int(h["height"]), int(h.get("block_weight") or h["block_size"])) for h in hs]
        _weights["tip"] = tip
    return _weights["w"]


def penalty(b, m):
    """the share of the base block reward that is cut for a block of weight b when the effective median is m (nothing up to the median, all of it at twice the median)"""
    return 0.0 if b <= m else min(1.0, (b / m - 1) ** 2)


def blocksize_parts():
    """the Dynamic Block Size logic of the block that is being mined, as the pieces of the page that change"""
    info = rpc("get_info")
    height = int(info["height"])
    ws = last_weights(height - 1)
    srt = sorted(w for _, w in ws)
    med = (srt[len(srt) // 2] + srt[(len(srt) - 1) // 2]) / 2 if srt else 0
    M = int(max(300000, med))
    pool = NODE_RPC.post("/get_transaction_pool", b"{}", 20).get("transactions") or []
    txs = sorted(((int(t["fee"]) / max(1, int(t.get("weight") or t.get("blob_size") or 1)), int(t["fee"]), max(1, int(t.get("weight") or t.get("blob_size") or 1)), t["id_hash"])
                  for t in pool if not t.get("double_spend_seen") and not t.get("do_not_relay")), reverse=True)
    waiting = sum(t[2] for t in txs)
    base = TAIL_REWARD
    chips = "<span class=chip>Block being mined <b>" + "{:,}".format(height) + "</b></span><span class=chip>last <b>" + str(len(ws)) + "</b> blocks</span>"
    kb = lambda v: "{:,.0f} kB".format(v / 1000.0)
    tiles = [("Median of the last 100 blocks", kb(med), "{:,} B".format(int(med))), ("Effective median", kb(M), "never below 300 kB"), ("Block limit", kb(2 * M), "twice the effective median"),
             ("Waiting in the pool", kb(waiting), "{:.0f}% of the median".format(waiting / M * 100))]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:20px'>" + v + "</b><em>" + sub + "</em></div>" for k, v, sub in tiles)
    # chart: the weight of each of the last blocks, the median and the limit
    W, H, L, B = 1000, 230, 64, 22
    top = max(2 * M * 1.08, max((w for _, w in ws), default=0) * 1.05)
    Y = lambda v: H - B - v / top * (H - B - 8)
    bw = (W - L - 6) / max(1, len(ws))
    bars = "".join("<rect x='" + "{:.1f}".format(L + i * bw + 1) + "' y='" + "{:.1f}".format(Y(w)) + "' width='" + "{:.1f}".format(max(1, bw - 2)) + "' height='" + "{:.1f}".format(H - B - Y(w)) + "' rx=1.5><title>Block " + "{:,}".format(h) + ": " + "{:,}".format(w) + " B</title></rect>" for i, (h, w) in enumerate(ws))
    svg = ("<svg class=bsz viewBox='0 0 " + str(W) + " " + str(H) + "' role=img aria-label='The weight of the last 100 blocks, their median and the block limit'>"
           "<line class=ax x1=" + str(L) + " x2=" + str(W) + " y1=" + str(H - B) + " y2=" + str(H - B) + " />"
           "<g class=bars>" + bars + "</g>"
           "<line class=med x1=" + str(L) + " x2=" + str(W) + " y1='" + "{:.1f}".format(Y(M)) + "' y2='" + "{:.1f}".format(Y(M)) + "' /><line class=lim x1=" + str(L) + " x2=" + str(W) + " y1='" + "{:.1f}".format(Y(2 * M)) + "' y2='" + "{:.1f}".format(Y(2 * M)) + "' />"
           "<text x=" + str(L - 6) + " y='" + "{:.1f}".format(Y(M) + 4) + "' class=tk>" + kb(M) + "</text><text x=" + str(L - 6) + " y='" + "{:.1f}".format(Y(2 * M) + 4) + "' class=tk>" + kb(2 * M) + "</text><text x=" + str(L - 6) + " y=" + str(H - B + 4) + " class=tk>0</text></svg>")
    chart = svg + "<p class=legend><span class=k3></span> a block's weight <span class=k1></span> effective median <span class=k4></span> block limit (2 ×)</p>"
    q = waiting / M
    steps = (mst("1", "Look at the last 100 blocks", "how big they were, one bar for each",
                 "<div class=big2>" + kb(med) + " <small>median</small></div><div class=sub>" + "{:,}".format(int(med)) + " bytes · the middle one when the blocks are put in order</div>", "s1")
             + mst("2", "Set the effective median", "never below 300 kB, so a quiet chain does not shrink the blocks",
                   "<div class=big2>" + kb(M) + "</div><div class=sub>the size a block may reach without any penalty</div>", "s2")
             + mst("3", "Draw the limit", "a block may be at most twice the effective median",
                   "<div class=big2>" + kb(2 * M) + "</div><div class=sub>a block bigger than this is invalid</div>", "s3")
             + mst("4", "Charge for what is above the median", "the base reward shrinks by (block size ÷ median − 1)²; the fees are not cut",
                   "<div class=big2>" + ("{:.0f}".format(penalty(waiting, M) * 100) + "% <small>cut if everything waiting went in</small>" if waiting > M else "no penalty <small>right now</small>") + "</div>"
                   "<div class=sub>" + kb(waiting) + " is waiting, " + "{:.0f}".format(q * 100) + "% of the median</div>", "s4"))
    bars = [w for _, w in ws[-8:]]
    return {"chips": chips, "steps": steps, "bars": bars, "tiles": tl, "chart": chart, "height": height, "median": M, "waiting": waiting, "base": base, "raw": int(med)}


