    if NODE:
        threading.Thread(target=worker, daemon=True).start()
    else:
        log("no Monero node configured: only passing the explorer through")
    log("listening on port " + str(PORT))
    CappedServer(("0.0.0.0", PORT), Handler).serve_forever()
