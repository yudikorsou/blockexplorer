# ---------- the block template of your node: header fields and the merkle root (Monero's tree hash) ----------
# Monero hashes with the original Keccak-256 (not the SHA-3 that hashlib offers), so it is written out here.
_RC = [0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000, 0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
       0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A, 0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
       0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008]
_ROT = [[0, 36, 3, 41, 18], [1, 44, 10, 45, 2], [62, 6, 43, 15, 61], [28, 55, 25, 21, 56], [27, 20, 39, 8, 14]]
_M64 = (1 << 64) - 1


def _keccak_f(a):
    for rc in _RC:
        c = [a[x][0] ^ a[x][1] ^ a[x][2] ^ a[x][3] ^ a[x][4] for x in range(5)]
        d = [c[(x - 1) % 5] ^ (((c[(x + 1) % 5] << 1) | (c[(x + 1) % 5] >> 63)) & _M64) for x in range(5)]
        a = [[a[x][y] ^ d[x] for y in range(5)] for x in range(5)]
        b = [[0] * 5 for _ in range(5)]
        for x in range(5):
            for y in range(5):
                v, n = a[x][y], _ROT[x][y]
                b[y][(2 * x + 3 * y) % 5] = ((v << n) | (v >> (64 - n))) & _M64 if n else v
        a = [[b[x][y] ^ ((~b[(x + 1) % 5][y]) & b[(x + 2) % 5][y]) for y in range(5)] for x in range(5)]
        a[0][0] ^= rc
    return a


def keccak256(data):
    rate = 136
    data = bytearray(data) + b"\x01"
    data += b"\x00" * (-len(data) % rate)
    data[-1] |= 0x80
    a = [[0] * 5 for _ in range(5)]
    for off in range(0, len(data), rate):
        for i in range(rate // 8):
            a[i % 5][i // 5] ^= int.from_bytes(data[off + 8 * i:off + 8 * i + 8], "little")
        a = _keccak_f(a)
    return b"".join(a[i % 5][i // 5].to_bytes(8, "little") for i in range(4))


def tree_hash(hashes):
    """the merkle root of a block's transaction hashes, as Monero builds it (the miner transaction first)"""
    count = len(hashes)
    if count == 1:
        return hashes[0]
    if count == 2:
        return keccak256(hashes[0] + hashes[1])
    cnt = 2
    while cnt < count:
        cnt <<= 1
    cnt >>= 1
    ints = list(hashes[:2 * cnt - count]) + [b""] * (count - cnt)
    i = 2 * cnt - count
    for j in range(2 * cnt - count, cnt):
        ints[j] = keccak256(hashes[i] + hashes[i + 1])
        i += 2
    ints = ints[:cnt]
    while cnt > 2:
        cnt >>= 1
        ints = [keccak256(ints[2 * k] + ints[2 * k + 1]) for k in range(cnt)]
    return keccak256(ints[0] + ints[1])


_template = {"at": 0, "data": None}


def varint(n):
    out = bytearray()
    while n >= 0x80:
        out.append((n & 0x7F) | 0x80)
        n >>= 7
    out.append(n)
    return bytes(out)


def block_template():
    """what your node would put in the next block: the header fields and the tree hash of the miner transaction and the best-paying pool transactions.
    The miner transaction pays whoever finds the block, which only the miner knows: a stand-in transaction hash takes its place, as the Block assembly shows it."""
    if _template["data"] and time.time() - _template["at"] < 8:
        return _template["data"]
    info = rpc("get_info")
    hdr = rpc("get_last_block_header")["block_header"]
    pool = NODE_RPC.post("/get_transaction_pool", b"{}", 20).get("transactions") or []
    best = sorted((t for t in pool if not t.get("double_spend_seen") and not t.get("do_not_relay")), key=lambda t: t["fee"] / max(1, int(t.get("weight") or t.get("blob_size") or 1)), reverse=True)
    median = max(300000, int(info.get("block_weight_median") or info.get("block_size_median") or 0))
    chosen, used = [], 0
    for t in best:                                  # best rate first, until the block is as big as the effective median
        w = max(1, int(t.get("weight") or t.get("blob_size") or 1))
        if used + w > median or len(chosen) >= 500:
            break
        used += w
        chosen.append((t["id_hash"], w, int(t["fee"])))
    ids = [c[0] for c in chosen]
    height = int(info["height"])
    coinbase = keccak256(("miner_tx|%d|hashes.space" % height).encode())
    root = tree_hash([coinbase] + [bytes.fromhex(i) for i in ids])
    now = int(time.time())
    major, minor, prev = int(hdr["major_version"]), int(hdr["minor_version"]), info["top_block_hash"]
    blob = varint(major) + varint(minor) + varint(now) + bytes.fromhex(prev) + b"\x00\x00\x00\x00" + root + varint(len(ids) + 1)
    data = {"height": height, "majorVersion": major, "minorVersion": minor, "timestamp": now,
            "prevId": prev, "nonce": None, "merkleroot": root.hex(), "nTx": len(ids) + 1, "txids": ids[:3],
            "reward": int(hdr.get("reward") or 0), "difficulty": int(info.get("difficulty") or 0),
            "lastTime": int(hdr.get("timestamp") or 0), "minerTx": coinbase.hex(), "txs": chosen, "weight": used, "median": median, "blob": blob.hex(), "fees": sum(c[2] for c in chosen)}
    _template["data"], _template["at"] = data, time.time()
    return data


_p2p_meta = {}    # height -> the block's hash, transaction count and size


def p2pool_blocks():
    """the P2Pool blocks of the last day (the window the worker reads), newest first, in mempool's /api/v1/blocks format: the pool page on hashes.space draws them"""
    with _lock:
        heights = sorted((h for h in list(_coin) if len(_coin[h]) > 1 and h in _headers), reverse=True)
    out = []
    for h in heights:
        if h not in _p2p_meta:
            try:
                hd = rpc("get_block_header_by_height", {"height": h})["block_header"]
                _p2p_meta[h] = {"id": hd["hash"], "tx_count": int(hd.get("num_txes", 0)) + 1, "size": int(hd.get("block_size", 0)), "prev": hd.get("prev_hash")}
            except Exception as exc:
                log("p2pool block header " + str(h) + ": " + str(exc))
                continue
        m = _p2p_meta[h]
        out.append({"id": m["id"], "height": h, "timestamp": _headers[h][0], "tx_count": m["tx_count"], "size": m["size"], "weight": m["size"],
                    "previousblockhash": m["prev"], "extras": {"pool": {"name": "P2Pool"}}})
    for h in [h for h in _p2p_meta if h not in _coin]:
        del _p2p_meta[h]
    return out


# ---------- the next block: when it is expected ----------
# Blocks are found by chance (every hash is an independent try), so no node can know the moment; the average wait is what can be worked out, and the
# better the pace of the miners is known, the better that average is. It is estimated from several things together:
#   1. the real pace of the miners: the hashes the last blocks took, over the time they took, the newest counting most (the weight halves every NEXT_HALF blocks)
#      and the block timestamps taken end to end, so one block with a wrong clock does no harm
#   2. the difficulty of the block that is being mined now (not the last one's): at a Bitcoin retarget it follows from the period's pace, on a chain that
#      retargets every block it is the node's own number for the next block
#   3. the chain's target, as a limit: an average outside a tenth to ten times the target is not believed
# The block that comes next takes `w_next` hashes at that pace, so the average wait is w_next / pace. The error of the pace shrinks with the blocks that count.
def next_block_estimate(blocks, w_next, half):
    """blocks: [(time, hashes the block took)], oldest first. Returns (average wait in seconds, relative error, blocks that count) or None."""
    num = den = wsum = w2 = 0.0
    n = len(blocks)
    for j in range(1, n):
        wt = 0.5 ** ((n - 1 - j) / half)
        num += wt * blocks[j][1]
        den += wt * (blocks[j][0] - blocks[j - 1][0])
        wsum += wt
        w2 += wt * wt
    if num <= 0 or den <= 0 or w_next <= 0:
        return None
    n_eff = wsum * wsum / w2 if w2 else 0.0
    return w_next / (num / den), (1 / math.sqrt(n_eff) if n_eff > 0 else 1.0), n_eff


def next_block_answer(chain, tip, last_time, mean, err, n_eff, window, target, change, retarget):
    mean = max(target / 10.0, min(target * 10.0, mean))
    return {"chain": chain, "tip": tip, "lastBlockTime": last_time, "targetSeconds": target, "meanSeconds": round(mean, 1),
            "medianSeconds": round(mean * 0.6931, 1), "relativeError": round(err, 3), "blocksCounted": int(n_eff), "windowBlocks": window,
            "nextDifficultyChange": round(change, 2), "retargetNext": retarget, "updated": int(time.time())}



NEXT_WINDOW, NEXT_HALF, TARGET_SECONDS = 360, 90.0, 120       # twelve hours of blocks looked at; the weight of a block halves every 90 blocks
_next = {"at": 0.0, "data": None}


def next_block():
    with _lock:
        if _next["data"] and time.time() - _next["at"] < 15:
            return _next["data"]
    info = rpc("get_info")
    tip = int(info["height"]) - 1
    first = max(1, tip - NEXT_WINDOW + 1)
    rows = [header_at(h) for h in range(first, tip + 1)]          # (timestamp, difficulty): a block's difficulty is the hashes it took
    if len(rows) < 10:
        raise RuntimeError("not enough blocks to tell")
    w_tip, w_next = float(rows[-1][1]), float(info["difficulty"])  # get_info names the difficulty of the NEXT block (LWMA sets it at every block)
    est = next_block_estimate([(r[0], float(r[1])) for r in rows], w_next, NEXT_HALF)
    if not est:
        raise RuntimeError("not enough blocks to tell")
    out = next_block_answer("monero", tip, rows[-1][0], est[0], est[1], est[2], len(rows), TARGET_SECONDS, (w_next / w_tip - 1) * 100, False)
    with _lock:
        _next["at"], _next["data"] = time.time(), out
    return out


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "hashes.space"
    timeout = 30                  # a client that stops sending (slow-loris) is dropped after 30 s

    def log_message(self, fmt, *args):     # one line per request, without the client address
        log(fmt % args)

    def send_json(self, code, obj, seconds):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(seconds))
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def mining(self, path):
        if path == "/api/v1/mining/pool/p2pool/blocks":
            return self.send_json(200, p2pool_blocks(), 30)
        if path == "/api/v1/mining/next-block":
            try:
                return self.send_json(200, next_block(), 10)
            except Exception as exc:
                return self.send_json(503, {"error": "the node did not answer: " + str(exc)}, 0)
        m = re.fullmatch(r"/api/v1/mining/(hashrate|pools|pool-hashrate|solo|p2pool)/(\w+)", path)
        if not m:
            return self.send_json(404, {"error": "unknown endpoint"}, 0)
        kind, rng = m.groups()
        with _lock:
            data = _result[kind].get(rng)
        if data is None:
            return self.send_json(503 if rng in RANGES or rng == "blocks" else 404, {"error": "Mining statistics are being computed from your node, try again in a minute" if rng in RANGES else "unknown period"}, 0)
        return self.send_json(200, data, 300)

    def forward(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > 1_000_000:        # the explorer only ever gets small requests
            self.close_connection = True
            return self.send_json(413, {"error": "request too large"}, 0)
        body = self.rfile.read(length) if length else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP and k.lower() != "host"}
        try:
            conn = http.client.HTTPConnection(EXPLORER_HOST, EXPLORER_PORT, timeout=60)
            conn.request(self.command, self.path, body=body, headers=headers)
            r = conn.getresponse()
            data = r.read()
        except Exception as exc:
            return self.send_json(502, {"error": "the explorer did not answer: " + str(exc)}, 0)
        finally:
            try:
                conn.close()
            except Exception:
                pass
        self.send_response(r.status)
        for k, v in r.getheaders():
            if k.lower() not in HOP:
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def handle_any(self):
        path = self.path.split("?")[0]
        if path.startswith("/api/v1/mining/") and self.command in ("GET", "HEAD"):
            return self.mining(path)
        if path == "/api/v1/block-template" and self.command in ("GET", "HEAD") and NODE:
            try:
                return self.send_json(200, block_template(), 8)
            except Exception as exc:
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
        if path == "/block-candidate.json" and self.command in ("GET", "HEAD") and NODE:
            try:
                return self.send_json(200, candidate_parts(), 0)
            except Exception as exc:
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
        if path == "/block-candidate" and self.command == "GET" and NODE:
            try:
                body = candidate_page().encode()
            except Exception as exc:
                log("block candidate:", exc)
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        if path == "/block-assembly.json" and self.command in ("GET", "HEAD") and NODE:
            try:
                return self.send_json(200, assembly_parts(), 0)
            except Exception as exc:
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
        if path == "/block-assembly" and self.command == "GET" and NODE:
            try:
                body = assembly_page().encode()
            except Exception as exc:
                log("block assembly:", exc)
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        if path == "/block-size.json" and self.command in ("GET", "HEAD") and NODE:
            try:
                return self.send_json(200, blocksize_parts(), 0)
            except Exception as exc:
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
        if path == "/block-size" and self.command == "GET" and NODE:
            try:
                body = blocksize_page().encode()
            except Exception as exc:
                log("block size:", exc)
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        if path == "/fee-ranking.json" and self.command in ("GET", "HEAD") and NODE:
            try:
                return self.send_json(200, ranking_parts(), 0)
            except Exception as exc:
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
        if path == "/fee-ranking" and self.command == "GET" and NODE:
            try:
                body = ranking_page().encode()
            except Exception as exc:
                log("fee ranking:", exc)
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        m = re.fullmatch(r"/block/([0-9]{1,9}|[0-9a-fA-F]{64})", path)
        t = re.fullmatch(r"/tx/([0-9a-fA-F]{64})", path)
        if (m or t) and self.command == "GET" and NODE and "classic=1" not in self.path:
            try:
                body = (block_page(m.group(1)) if m else tx_page(t.group(1))).encode()
            except Exception as exc:        # the node did not answer or does not know the block: the explorer's own page is the fallback
                log("block page:", exc)
            else:
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                return self.wfile.write(body)
        return self.forward()

    do_GET = do_POST = do_HEAD = do_OPTIONS = handle_any


class CappedServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 128
    _slots = threading.BoundedSemaphore(256)      # open connections at once; more get a quick "busy" answer

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            try:
                request.sendall(b"HTTP/1.1 503 Service Unavailable\r\nRetry-After: 5\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            except OSError:
                pass
            return self.shutdown_request(request)
        super().process_request(request, client_address)

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()


