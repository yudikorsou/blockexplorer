def hashrate_text(h):
    for unit, f in (("GH/s", 1e9), ("MH/s", 1e6), ("kH/s", 1e3)):
        if h >= f:
            return "{:,.2f}".format(h / f), unit
    return "{:,.0f}".format(h), "H/s"


def candidate_parts():
    """the block candidate of the block that is being mined, as the pieces of the page that change"""
    d = block_template()
    diff = int(d["difficulty"]) or 1
    rate = diff / BLOCK_SECONDS
    hv, hu = hashrate_text(rate)
    since = max(0, int(time.time()) - int(d["lastTime"])) if d["lastTime"] else 0
    chance = 1 - math.exp(-60.0 / BLOCK_SECONDS)
