#!/usr/bin/env python3
"""Monero Explorer front: the explorer itself, plus mining statistics from your own node.

The Onion Monero Blockchain Explorer (xmrblocks) answers every request it knows (its pages and
its /api/... JSON). This small server stands in front of it on the app's port, hands everything
on to it unchanged, and adds the two endpoints the hashes.space Find Mempool page reads for its
"Global hashrate" and "Mining pools" sections, in mempool's shape:

  /api/v1/mining/hashrate/<period>   hashrate and difficulty over the period
  /api/v1/mining/next-block          when the next block is expected: the average wait, from the pace of the last 360 blocks and the next block's difficulty
  /api/v1/mining/pools/<period>      how the period's blocks were paid out
  /api/v1/mining/pool-hashrate/<period>  the hashrate of the P2Pool miners (the only pool whose blocks the chain shows): network hashrate times the share of P2Pool blocks
  /api/v1/mining/solo/blocks         the P2Pool miners (decentralised solo mining) read block by block: Monero retargets every block (a 120 s target)
  /api/v1/mining/pool/p2pool/blocks  the P2Pool blocks of the last day, one by one, for the P2Pool pool profile on hashes.space
  /api/v1/mining/p2pool/blocks       the P2Pool page: hashrate per slice of blocks, the latest P2Pool blocks and how each paid its miners
  (period: 24h, 14d, 1m, 6m or 1y; 1w is still answered for older versions of the page)

so the page gets those graphs from the same Monero Explorer that streams the blocks
(xmr.hashes.space), computed from the Monero Node app on this Umbrel.

A note on Monero and pool names. On Bitcoin every block says who mined it: the pool writes its
name into the coinbase. Monero blocks say nothing of the sort - the reward goes to a one-time
address that reveals nothing - so no node can tell you "F2Pool mined this block". What the chain
does show is how a block's reward was split. P2Pool, the decentralised pool, pays every one of its
miners directly in the block's own coinbase, so its blocks carry many payouts; a block from a
custodial pool (or from a solo miner) carries a single payout. That split is what is shown.
"""

import hashlib
import http.client
import http.server
import json
import math
import os
import re
import secrets
import socketserver
import threading
import time
import urllib.request

PORT = int(os.environ.get("PORT", "3000"))
EXPLORER_HOST = os.environ.get("EXPLORER_HOST", "explorer")
EXPLORER_PORT = int(os.environ.get("EXPLORER_PORT", "8081"))

NODE = os.environ.get("MONERO_HOST", "")
NODE_PORT = os.environ.get("MONERO_RPC_PORT", "18081")
LOGIN = os.environ.get("MONERO_RPC_AUTH", "")  # user:password, from the Monero Node app

BLOCK_SECONDS = 120          # Monero's target block time: hashrate = difficulty / 120
DAY = 86400
WEEK = 7 * DAY
YEAR = 365 * DAY
BLOCKS_PER_DAY = DAY // BLOCK_SECONDS


def log(*a):
    print("[stats]", *a, flush=True)


# ---------- the Monero node ----------

class Node:
    """Talks to monerod over HTTP digest auth.

    monerod ties its digest nonce to the TCP connection, so a fresh connection per request is
    answered with 401 forever. This keeps one connection open, does the challenge once on it and
    reuses it; if the node closes it, the next call reconnects and challenges again."""

    def __init__(self, host, port, login):
        self.host, self.port = host, int(port)
        self.user, _, self.password = login.partition(":")
        self.conn, self.chal, self.nc = None, None, 0
        self.lock = threading.Lock()

    @staticmethod
    def _parse(header):
        # monerod offers MD5 and MD5-sess in one header; the first (MD5) is the one we answer
        first = header.split(", Digest")[0]
        return dict((m[0].lower(), m[1].strip('"')) for m in re.findall(r'(\w+)=("[^"]*"|[^,]*)', first))

    def _authorization(self, path):
        c = self.chal
        self.nc += 1
        nc, cnonce = "{:08x}".format(self.nc), secrets.token_hex(8)
        md5 = lambda text: hashlib.md5(text.encode()).hexdigest()
        ha1 = md5(self.user + ":" + c.get("realm", "") + ":" + self.password)
        ha2 = md5("POST:" + path)
        resp = md5(ha1 + ":" + c.get("nonce", "") + ":" + nc + ":" + cnonce + ":auth:" + ha2)
        return ('Digest username="' + self.user + '", realm="' + c.get("realm", "") + '", nonce="'
                + c.get("nonce", "") + '", uri="' + path + '", algorithm=MD5, qop=auth, nc=' + nc
                + ', cnonce="' + cnonce + '", response="' + resp + '"')

    def _send(self, path, body, timeout):
        headers = {"Content-Type": "application/json", "Connection": "keep-alive"}
        if self.chal and self.password:
            headers["Authorization"] = self._authorization(path)
        self.conn.timeout = timeout
        self.conn.request("POST", path, body=body, headers=headers)
        r = self.conn.getresponse()
        data = r.read()
        return r.status, r.getheader("WWW-Authenticate") or r.getheader("WWW-authenticate") or "", data

    def post(self, path, body, timeout):
        with self.lock:
            for attempt in (1, 2, 3):
                try:
                    if self.conn is None:
                        self.conn = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
                        self.chal, self.nc = None, 0
                    status, challenge, data = self._send(path, body, timeout)
                except (http.client.HTTPException, OSError):
                    self._drop()
                    if attempt == 3:
                        raise
                    continue
                if status == 401 and challenge.lower().startswith("digest") and self.password:
                    self.chal, self.nc = self._parse(challenge), 0
                    continue
                if status != 200:
                    raise RuntimeError("the Monero node answered HTTP " + str(status))
                return json.loads(data)
        raise RuntimeError("the Monero node would not authenticate")

    def _drop(self):
        try:
            if self.conn:
                self.conn.close()
        except Exception:
            pass
        self.conn, self.chal, self.nc = None, None, 0


NODE_RPC = Node(NODE, NODE_PORT, LOGIN)


def rpc(method, params=None, timeout=20):
    body = json.dumps({"jsonrpc": "2.0", "id": "0", "method": method, "params": params or {}}).encode()
    out = NODE_RPC.post("/json_rpc", body, timeout)
    if "error" in out:
        raise RuntimeError(str(out["error"]))
    return out["result"]


def payouts_in(height):
    """How many miners this block paid directly. P2Pool pays all of its miners in the block's
    own coinbase, so its blocks have many outputs; everything else has one."""
    block = rpc("get_block", {"height": height})
    miner = json.loads(block["json"])["miner_tx"]
    return max(1, len(miner.get("vout") or []))


# ---------- the periods the page offers ----------
# blocks in the period, and one hashrate point per STEP blocks (a block every 2 minutes). "1w" is what older
# versions of the page ask for.
RANGES = {"24h": (720, 30), "1w": (5040, 60), "14d": (10080, 180), "1m": (21600, 360), "6m": (129600, 1440), "1y": (262800, 1440)}
SAMPLE = 2500   # a long period reads about this many blocks for its payout split (an estimate); a short one reads them all

_lock = threading.Lock()
_headers = {}    # height -> (timestamp, difficulty)
_payouts = {}    # height -> how many outputs its coinbase pays
_result = {"hashrate": {}, "pools": {}, "pool-hashrate": {}, "solo": {}, "p2pool": {}, "info": None}


def header_at(height):
    if height not in _headers:
        hd = rpc("get_block_header_by_height", {"height": height})["block_header"]
        _headers[height] = (int(hd["timestamp"]), int(hd["difficulty"]))
    return _headers[height]


def hashrate_range(tip, info, rng):
    blocks, step = RANGES[rng]
    heights = [tip - d * step for d in range(blocks // step) if tip - d * step > 1][::-1]
    points = []
    for h in heights:
        try:
            points.append(header_at(h))
        except Exception as exc:
            log("header " + str(h) + ": " + str(exc))
    now = int(info["difficulty"])
    return {"currentHashrate": now / BLOCK_SECONDS, "currentDifficulty": now,
            "hashrates": [{"timestamp": t, "avgHashrate": d / BLOCK_SECONDS} for t, d in points],
            "difficulty": [{"time": t, "difficulty": d} for t, d in points]}


def pools_range(tip, rng):
    """the payout split of one period: every block of a short one, an evenly spread sample of a long one (scaled up)"""
    blocks = RANGES[rng][0]
    first = max(1, tip - blocks + 1)
    stride = max(1, blocks // SAMPLE)
    heights = [h for h in range(first, tip + 1) if h % stride == 0]
    for h in heights:
        if h not in _payouts:
            try:
                _payouts[h] = payouts_in(h)
            except Exception as exc:          # one unreadable block must not sink the whole period
                log("block " + str(h) + ": " + str(exc))
    seen = [_payouts[h] for h in heights if h in _payouts]
    if not seen:
        raise RuntimeError("no data yet")
    scale = (tip - first + 1) / len(seen)     # 1 when every block was read
    shared = sum(1 for o in seen if o > 1)
    payouts = sum(o for o in seen if o > 1)
    pools = []
    if shared:
        n = max(1, round(shared * scale))
        pools.append({"name": "P2Pool", "slug": "p2pool", "blockCount": n,
                      "miners": [{"name": str(round(payouts / shared)) + " miners paid per block", "blockCount": n}]})
    single = len(seen) - shared
    if single:
        pools.append({"name": "Single payout (pool or solo miner)", "blockCount": max(1, round(single * scale))})
    return {"blockCount": tip - first + 1, "sampled": stride > 1, "pools": pools}


def pool_hashrate_range(tip, rng, hr):
    """Monero names no pool, but P2Pool pays all of its miners in the block itself, so its blocks can be told apart: the hashrate of
    those miners is the network's hashrate times the share of P2Pool blocks around each point (all blocks read for a short period, a spread sample for a long one)"""
    blocks, step = RANGES[rng]
    first = max(1, tip - blocks + 1)
    stride = max(1, blocks // SAMPLE)
    reach = max(step, blocks // 52)
    heights = [tip - d * step for d in range(blocks // step) if tip - d * step > 1][::-1]
    stamp = {}
    for h in heights:
        if h in _headers:
            stamp[_headers[h][0]] = h
    points = []
    for pt in hr["hashrates"]:
        h = stamp.get(pt["timestamp"])
        if h is None:
            continue
        seen = [_payouts[k] for k in range(h - reach + 1, h + 1) if k % stride == 0 and k >= first and k in _payouts]
        if seen:
            share = sum(1 for o in seen if o > 1) / len(seen)
            points.append({"timestamp": pt["timestamp"], "avgHashrate": pt["avgHashrate"] * share, "share": share, "networkHashrate": pt["avgHashrate"]})
    if not points:
        raise RuntimeError("no data yet")
    seen = [_payouts[k] for k in range(max(first, tip - max(step, 5040) + 1), tip + 1) if k % stride == 0 and k in _payouts]
    now = sum(1 for o in seen if o > 1) / len(seen) if seen else points[-1]["share"]
    return {"currentHashrate": hr["currentHashrate"] * now, "currentShare": now, "networkHashrate": hr["currentHashrate"], "complete": True,
            "sampled": stride > 1, "pool": "P2Pool", "hashrates": points}


# ---------- P2Pool, block by block ----------
# Monero retargets its difficulty at EVERY block (LWMA) and aims at 120 s per block, so a block's difficulty / 120 is the hashrate that found it.
# The window is the last P2P_BLOCKS blocks (a day). The network's per-block hashrate is the median over those blocks; P2Pool's is the share of
# the window's blocks that P2Pool found (blocks that pay several miners in their own coinbase) times that median. The coinbase amounts are public,
# so each miner paid in a P2Pool block shows its share of that block's reward: P2Pool's hashrate split by that share is that miner's hashrate.
P2P_BLOCKS, P2P_SLICE, P2P_LATEST = 720, 12, 30
_coin = {}       # height -> the amounts a block's coinbase pays (atomic units)


def coinbase_in(height):
    block = rpc("get_block", {"height": height})
    miner = json.loads(block["json"])["miner_tx"]
    return [int(o.get("amount") or 0) for o in (miner.get("vout") or [])] or [0]


def _median(xs):
    xs = sorted(xs)
    n = len(xs)
    return 0 if not n else xs[n // 2] if n % 2 else (xs[n // 2 - 1] + xs[n // 2]) / 2



# ---------- what the big pools say they hold (a self-reported number, used to carve the solo miners out of the single payouts) ----------
# Monero blocks name no pool, so the only way to see solo miners is by subtraction: the network's hashrate, minus P2Pool (read from the
# chain), minus the hashrate the large pools publish themselves. What is left is solo miners and pools that are not listed here.
# Each pool answers on its own public stats page; one that does not answer is simply left out (and the page says which ones did).
POOL_APIS = [
    ("SupportXMR", "https://www.supportxmr.com/api/pool/stats"),
    ("MoneroOcean", "https://api.moneroocean.stream/pool/stats"),
    ("Nanopool", "https://api.nanopool.org/v1/xmr/pool/hashrate"),
    ("HeroMiners", "https://monero.herominers.com/api/stats"),
    ("HashVault", "https://api.hashvault.pro/v3/monero/stats"),
]
_pool_rep = {"at": 0, "pools": []}


def _find_hashrate(obj):
    """The pool's hashrate (H/s) from whatever shape its stats come in: a plain number, or a field called hashrate / hashRate."""
    if isinstance(obj, (int, float)) and not isinstance(obj, bool):
        return float(obj)
    if isinstance(obj, dict):
        for key, val in obj.items():
            if key.lower() in ("hashrate", "pool_hashrate", "poolhashrate", "hash_rate") and isinstance(val, (int, float)) and val > 0:
                return float(val)
        for key in ("data", "pool_statistics", "pool", "stats"):
            if key in obj:
                got = _find_hashrate(obj[key])
                if got:
                    return got
    return 0.0


def refresh_pool_reports():
    if time.time() - _pool_rep["at"] < 600 and _pool_rep["pools"]:
        return
    got = []
    for name, url in POOL_APIS:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "hashes.space Monero Explorer"})
            with urllib.request.urlopen(req, timeout=8) as r:
                hr = _find_hashrate(json.loads(r.read().decode()))
            if hr > 0:
                got.append({"name": name, "hashrate": hr})
        except Exception as exc:
            log("pool report " + name + ": " + str(exc))
    _pool_rep["at"] = time.time()
    if got:
        _pool_rep["pools"] = got


def p2pool_window(tip):
    first = max(2, tip - P2P_BLOCKS + 1)
    for h in range(first, tip + 1):
        try:
            header_at(h)
            if h not in _coin:
                _coin[h] = coinbase_in(h)
                _payouts[h] = len(_coin[h])
        except Exception as exc:
            log("p2pool block " + str(h) + ": " + str(exc))
    for h in [h for h in _coin if h < first]:
        del _coin[h]
    heights = [h for h in range(first, tip + 1) if h in _coin and h in _headers]
    if len(heights) < P2P_SLICE:
        raise RuntimeError("no data yet")
    rate = {h: _headers[h][1] / BLOCK_SECONDS for h in heights}
    med = _median(rate.values())
    shared = [h for h in heights if len(_coin[h]) > 1]
    share = len(shared) / len(heights)
    p2p = med * share
    slices = [heights[i:i + P2P_SLICE] for i in range(0, len(heights), P2P_SLICE)]
    slices = [sl for sl in slices if len(sl) >= P2P_SLICE // 2]
    series = []
    for sl in slices:
        net = sum(rate[h] for h in sl) / len(sl)
        sh = [h for h in sl if len(_coin[h]) > 1]
        series.append({"timestamp": _headers[sl[-1]][0], "height": sl[-1], "avgHashrate": net * len(sh) / len(sl), "share": len(sh) / len(sl), "networkHashrate": net,
                       "miners": round(sum(len(_coin[h]) for h in sh) / len(sh)) if sh else 0})
    latest = []
    for h in shared[::-1][:P2P_LATEST]:
        amounts = sorted(_coin[h], reverse=True)
        total = sum(amounts) or 1
        latest.append({"height": h, "timestamp": _headers[h][0], "miners": len(amounts), "reward": total, "blockHashrate": rate[h], "difficulty": _headers[h][1],
                       "shares": [round(a / total, 5) for a in amounts[:60]], "others": max(0, len(amounts) - 60)})
    # the miners of the newest P2Pool block, each with the hashrate its payout share stands for, and the sizes over the latest blocks
    miners = [round(p2p * x, 1) for x in (latest[0]["shares"] if latest else [])]
    sizes = [round(p2p * sh, 1) for b in latest for sh in b["shares"]]
    base = {"window": "blocks", "perBlock": True, "retarget": "LWMA", "blockSeconds": BLOCK_SECONDS, "blockCount": len(heights), "sliceBlocks": P2P_SLICE, "slices": len(slices),
            "sinceBlock": heights[0], "tipBlock": heights[-1]}
    hashrate = {"hashrates": [{"timestamp": x["timestamp"], "avgHashrate": x["networkHashrate"]} for x in series],
                "difficulty": [{"time": _headers[sl[-1]][0], "height": sl[-1], "difficulty": _headers[sl[-1]][1]} for sl in slices],
                "currentHashrate": med, "currentDifficulty": _headers[heights[-1]][1], **base}
    reports = list(_pool_rep["pools"])
    single = 1 - share
    listed = min(single, sum(x["hashrate"] for x in reports) / med) if med else 0
    solo_share = max(0.0, single - listed)
    listed_share, solo_share_ = listed, solo_share
    pools = {"pools": ([{"name": "P2Pool", "slug": "p2pool", "blockCount": len(shared), "hashrate": p2p,
                         "miners": [{"name": str(round(sum(len(_coin[h]) for h in shared) / len(shared))) + " miners paid per block", "blockCount": len(shared)}]}] if shared else [])
             + ([{"name": "Large pools (as they report)", "blockCount": round((len(heights) - len(shared)) * listed_share / (1 - share)) if share < 1 else 0, "hashrate": med * listed_share},
                 {"name": "Solominers estimate", "blockCount": round((len(heights) - len(shared)) * solo_share_ / (1 - share)) if share < 1 else 0, "hashrate": med * solo_share_}] if len(heights) > len(shared) else []),
             "sampled": False, "lastEstimatedHashrate": med, **base}
    pool_hr = {"currentHashrate": p2p, "currentShare": share, "networkHashrate": med, "complete": True, "sampled": False, "pool": "P2Pool",
               "hashrates": [{k: x[k] for k in ("timestamp", "avgHashrate", "share", "networkHashrate")} for x in series], **base}
    # a pool that says more than the single payouts hold (they all report a little high) is scaled down so the three parts add up to the network
    scale = (listed * med) / sum(x["hashrate"] for x in reports) if reports and listed else 0
    solo = {"soloBlocks": len(shared), "share": share, "currentHashrate": p2p, "networkHashrate": med, "sampled": False, "fullSplit": True,
            "sources": [{"name": "P2Pool miners", "kind": "service", "blockCount": len(shared), "share": share, "hashrate": p2p},
                        {"name": "Solominers estimate", "kind": "unattributed", "blockCount": 0, "share": solo_share, "hashrate": med * solo_share},
                        {"name": "Large pools (as they report)", "kind": "pools", "blockCount": 0, "share": listed, "hashrate": med * listed}],
            "reportedPools": [{"name": x["name"], "hashrate": x["hashrate"], "counted": x["hashrate"] * scale} for x in reports],
            "reportedTotal": sum(x["hashrate"] for x in reports), "reportedAt": _pool_rep["at"], **base}
    page = {"p2poolHashrate": p2p, "networkHashrate": med, "share": share, "p2poolBlocks": len(shared), "series": series, "latest": latest, "miners": miners, "sizes": sizes,
            "minersPerBlock": round(sum(len(_coin[h]) for h in shared) / len(shared)) if shared else 0, "currentDifficulty": _headers[heights[-1]][1], **base}
    return hashrate, pools, pool_hr, solo, page


def worker():
    first = True
    while True:
        try:
            info = rpc("get_info")
            tip = int(info["height"]) - 1
            try:
                refresh_pool_reports()
                hr0, pl0, ph0, so0, pg0 = p2pool_window(tip)
                with _lock:
                    _result["hashrate"]["blocks"], _result["pools"]["blocks"], _result["pool-hashrate"]["blocks"], _result["solo"]["blocks"], _result["p2pool"]["blocks"] = hr0, pl0, ph0, so0, pg0
                    _result["info"] = info
            except Exception as exc:
                log("p2pool window: " + str(exc))
            for rng in RANGES:                # the short periods first, so they are ready soonest
                hr, pl = hashrate_range(tip, info, rng), pools_range(tip, rng)
                try:
                    ph = pool_hashrate_range(tip, rng, hr)
                except Exception as exc:
                    log("pool hashrate " + rng + ": " + str(exc))
                    ph = None
                with _lock:
                    _result["hashrate"][rng], _result["pools"][rng] = hr, pl
                    if ph:
                        _result["pool-hashrate"][rng] = ph
                    _result["info"] = info
                if first and rng == "24h":
                    log("Monero mining statistics ready (longer periods follow)")
            first = False
        except Exception as exc:
            log("refresh: " + str(exc))
        time.sleep(600)


# ---------- the web server ----------

HOP = {"connection", "keep-alive", "transfer-encoding", "te", "trailer", "upgrade", "proxy-authenticate",
       "proxy-authorization", "content-length", "server", "date"}


