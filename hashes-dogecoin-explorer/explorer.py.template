# ----- 2. Coinbase & merkle root -----

def merkle_parts():
    t = doge_template()
    n = t["nleaves"]
    chips = chips_of(t, "<span class=chip><b>" + "{:,}".format(n) + "</b> hashes</span>")
    steps = (st("1", "The coinbase goes first", "the transaction that pays the miner: " + "{:,}".format(SUBSIDY // COIN) + " DOGE plus the fees (a stand-in hash until a miner builds the real one)",
                "<div class=big2>" + "{:,.2f}".format(t["reward"] / COIN) + " <small>DOGE reward</small></div><div class=sub>coinbase hash <span class=mono>" + short(t["cb"], 6, 4) + "</span></div>", "s1")
             + st("2", "Add the best-paying transactions", "the ones <a href='/fee-sorting'>fee sorting</a> picked, in that order",
                  "<div class=big2>" + "{:,}".format(n - 1) + " <small>transactions</small></div><div class=sub>" + "{:,.1f}".format(t["size"] / 1000.0) + " kB · fees " + doge(t["fees"]) + "</div>", "s2")
             + st("3", "Hash them in pairs", "each id twice through SHA-256, two by two, until one is left",
                  "<div class=big2>" + "{:,}".format(n) + " hashes → 1</div><div class=sub>" + str(t["rounds"]) + " round" + ("" if t["rounds"] == 1 else "s") + (" · a lone hash is paired with itself" if n > 1 else "") + "</div>", "s3")
             + st("4", "The merkle root", "one hash that stands for every transaction; it goes into the block header",
                  "<div class='big2 mono'>" + short(t["root"], 12, 8) + "</div><div class=sub>change one transaction and the whole root changes · <a href='/block-assembly'>into the header</a></div>", "s4"))
    short5 = lambda h: h[:5]
    mk = {"n": n, "leaves": [short5(x) for x in t["leaves"]], "l1": [short5(x) for x in t["l1"]], "root": t["root"][:8]}
    return {"chips": chips, "steps": steps, "height": t["height"], "root": t["root"], "mk": mk}


