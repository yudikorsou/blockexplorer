MAX_CONNECTIONS = 256          # open connections at once; more get a quick "busy" answer instead of one more thread
MAX_WS = 64                    # live (WebSocket) connections at once
MAX_WS_FRAME = 65536           # bytes a visitor may send in one WebSocket message
_ws_open = [0]


class CappedServer(ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 128
    _slots = threading.BoundedSemaphore(MAX_CONNECTIONS)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            try:
                request.sendall(b"HTTP/1.1 503 Service Unavailable\r\nRetry-After: 5\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            except OSError:
                pass
            return self.shutdown_request(request)
        super().process_request(request, client_address)

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()


class Handler(BaseHTTPRequestHandler):
    server_version = "dogecoin-explorer"
    protocol_version = "HTTP/1.1"
    timeout = 30                  # a client that stops sending (slow-loris) is dropped after 30 s; live connections set their own

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8", cache=0):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(cache) if cache else "no-store")
        self.end_headers()
        self.wfile.write(data)

    def json(self, obj, cache=0):
        self.send(200, json.dumps(obj), "application/json", cache)

    def do_GET(self):  # noqa: N802
        path, _, query = self.path.partition("?")
        params = dict(p.split("=", 1) for p in query.split("&") if "=" in p)
        try:
            if path == "/api/v1/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
                return self.websocket()
            if path == "/api/v1/blocks":
                return self.json([mempool_json(b) for b in last_blocks(10)], 10)
            if path == "/api/v1/fees/mempool-blocks":
                return self.json(_state["mempool"] or mempool_blocks(), 5)
            if path == "/api/v1/mempool/top":
                return self.json(mempool_top(), 8)
            m = re.fullmatch(r"/api/v1/mining/pool/([a-z0-9-]+)/blocks", path)
            if m:
                return self.json(pool_blocks(m.group(1)), 30)
            m = re.fullmatch(r"/api/v1/mining/block/([0-9]+|[0-9a-fA-F]{64})", path)
            if m:
                return self.json(block_mining(m.group(1)), 3600)
            m = re.fullmatch(r"/api/v1/mining/period-blocks/([0-9]+)", path)
            if m:
                return self.json(period_blocks(int(m.group(1))), 30)
            if path == "/api/v1/mining/next-block":
                return self.json(next_block(), 10)
            m = re.fullmatch(r"/api/v1/mining/(hashrate|pools|pool-hashrate|solo)/(\w+)", path)
            if m:
                data = _mining[m.group(1)].get(m.group(2))
                if data is None:
                    return self.send(503, json.dumps({"error": "Mining statistics are being computed from your node, try again in a minute"}), "application/json")
                return self.json(data, 300)
            for route, parts, build in (("/fee-sorting", fee_parts, fee_page), ("/coinbase-merkle", merkle_parts, merkle_page),
                                        ("/block-assembly", assembly_parts, assembly_page), ("/block-candidate", candidate_parts, candidate_page)):
                if path == route:
                    return self.send(200, build())
                if path == route + ".json":
                    return self.json(parts())
            if path == "/api/blocks/tip/height":
                return self.send(200, str(rpc("getblockcount")), "text/plain", 5)
            if path == "/":
                return self.send(200, home())
            if path.startswith("/block/"):
                return self.send(200, block_page(path[7:]))
            if path == "/verified":
                return self.send(200, verified_page())
            if path == "/api/v1/verified-addresses":
                return self.json(list(VERIFIED.values()), 300)
            if path.startswith("/api/v1/address/") and valid_address(path[16:]):
                return self.json(address_balance(path[16:]), 30)
            if path.startswith("/address/") and valid_address(path[9:]):
                return self.send(200, address_page(path[9:]))
            if path == "/search":
                q = urllib.request.unquote(params.get("q", "").replace("+", " ")).strip()
                if valid_address(q):
                    return self.redirect("/address/" + q)
                if q.isdigit():
                    return self.redirect("/block/" + q)
                if HEX64.fullmatch(q):
                    try:
                        rpc("getblockheader", q)
                        return self.redirect("/block/" + q)
                    except RpcError:
                        pass
                return self.send(404, page("Not found", "<h1>Nothing found</h1><p>Search for a block height, a block hash or a Dogecoin address.</p>"))
            return self.send(404, page("Not found", "<h1>Not found</h1>"))
        except (RpcError, ValueError) as exc:
            if path.startswith("/api/") or path.endswith(".json"):
                return self.send(502, json.dumps({"error": str(exc)}), "application/json")
            return self.send(502, page("Error", "<h1>Something went wrong</h1><p class=err>" + html.escape(str(exc)) + "</p>"))

    def redirect(self, to):
        self.send_response(302)
        self.send_header("Location", to)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def websocket(self):
        if _ws_open[0] >= MAX_WS:
            return self.send(503, json.dumps({"error": "too many live connections"}), "application/json")
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        sock = self.connection
        sock.settimeout(120)
        _ws_open[0] += 1
        try:
            while True:
                head = self.rfile.read(2)
                if len(head) < 2:
                    break
                op, ln = head[0] & 0x0F, head[1] & 0x7F
                if ln == 126:
                    ln = struct.unpack(">H", self.rfile.read(2))[0]
                elif ln == 127:
                    ln = struct.unpack(">Q", self.rfile.read(8))[0]
                if ln > MAX_WS_FRAME:
                    break
                mask = self.rfile.read(4) if head[1] & 0x80 else b"\0\0\0\0"
                data = bytes(c ^ mask[i % 4] for i, c in enumerate(self.rfile.read(ln)))
                if op == 8:
                    break
                if op == 9:
                    with _send_lock:
                        sock.sendall(bytes([0x8A, len(data)]) + data)
                    continue
                if op != 1:
                    continue
                try:
                    msg = json.loads(data)
                except ValueError:
                    continue
                if msg.get("action") == "want":
                    with _clients_lock:
                        _clients.add(sock)
                    ws_send(sock, json.dumps({"blocks": [mempool_json(b) for b in last_blocks(8)], "mempool-blocks": _state["mempool"] or mempool_blocks()}))
                elif msg.get("action") == "ping":
                    ws_send(sock, json.dumps({"pong": True}))
        except (OSError, RpcError, ValueError):
            pass
        finally:
            _ws_open[0] -= 1
            with _clients_lock:
                _clients.discard(sock)
            self.close_connection = True


def main():
    threading.Thread(target=poller, daemon=True).start()
    threading.Thread(target=mining_stats, daemon=True).start()
    server = CappedServer(("0.0.0.0", PORT), Handler)
    log("listening on port " + str(PORT))
    server.serve_forever()


if __name__ == "__main__":
    main()
