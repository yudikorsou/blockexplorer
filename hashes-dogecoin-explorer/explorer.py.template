class RpcError(Exception):
    pass


def rpc(method, *params, timeout=30):
    body = json.dumps({"jsonrpc": "1.0", "id": "x", "method": method, "params": list(params)}).encode()
    req = urllib.request.Request(RPC_URL, data=body, headers={"Authorization": AUTH, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            payload = json.loads(exc.read())
        except Exception:  # noqa: BLE001
            raise RpcError("HTTP " + str(exc.code))
    except OSError as exc:
        raise RpcError("Dogecoin Core is not reachable: " + str(exc))
    if payload.get("error"):
        raise RpcError(payload["error"].get("message", "RPC error"))
    return payload["result"]


def rpc_batch(calls):
    """several RPC calls in one request: [(method, params), ...] -> results (None where a call failed)"""
    body = json.dumps([{"jsonrpc": "1.0", "id": i, "method": m, "params": list(p)} for i, (m, p) in enumerate(calls)]).encode()
    req = urllib.request.Request(RPC_URL, data=body, headers={"Authorization": AUTH, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            out = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        out = json.loads(exc.read())
    except OSError as exc:
        raise RpcError("Dogecoin Core is not reachable: " + str(exc))
    res = [None] * len(calls)
    for item in out:
        if not item.get("error"):
            res[item["id"]] = item["result"]
    return res


# ---------- raw block and transaction parsing (Dogecoin: no SegWit, AuxPoW merge-mined headers) ----------

def sha256d(b):
    return hashlib.sha256(hashlib.sha256(b).digest()).digest()


class Reader:
    def __init__(self, data):
        self.d = data
        self.i = 0

    def take(self, n):
        out = self.d[self.i:self.i + n]
        if len(out) < n:
            raise ValueError("block data ended early")
        self.i += n
        return out

    def u32(self):
        return struct.unpack("<I", self.take(4))[0]

    def i32(self):
        return struct.unpack("<i", self.take(4))[0]

    def u64(self):
        return struct.unpack("<Q", self.take(8))[0]

    def varint(self):
        n = self.take(1)[0]
        if n < 0xFD:
            return n
        return struct.unpack("<" + {0xFD: "H", 0xFE: "I", 0xFF: "Q"}[n], self.take({0xFD: 2, 0xFE: 4, 0xFF: 8}[n]))[0]

    def varbytes(self):
        return self.take(self.varint())


def read_tx(r):
    start = r.i
    version = r.i32()
    vin = []
    for _ in range(r.varint()):
        prev = r.take(32)[::-1].hex()
        index = r.u32()
        script = r.varbytes()
        seq = r.u32()
        vin.append({"prev": prev, "n": index, "script": script, "seq": seq})
    vout = []
    for _ in range(r.varint()):
        value = r.u64()
        vout.append({"value": value, "script": r.varbytes()})
    locktime = r.u32()
    raw = r.d[start:r.i]
    return {"txid": sha256d(raw)[::-1].hex(), "version": version, "vin": vin, "vout": vout, "locktime": locktime, "size": len(raw),
            "coinbase": len(vin) == 1 and vin[0]["prev"] == "0" * 64}


def parse_block(raw_hex):
    r = Reader(bytes.fromhex(raw_hex))
    version = r.i32()
    r.take(76)  # rest of the 80-byte header
    parent_coinbase = None
    if version & 0x100:  # AuxPoW: the block was merge-mined (with Litecoin, mostly)
        parent_coinbase = read_tx(r)
        r.take(32)
        r.take(32 * r.varint())
        r.take(4)
        r.take(32 * r.varint())
        r.take(4)
        r.take(80)
    txs = [read_tx(r) for _ in range(r.varint())]
    return {"txs": txs, "parent_coinbase": parent_coinbase}


# ---------- addresses (base58check, Dogecoin mainnet) ----------

B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"


def b58check(prefix, payload):
    data = bytes([prefix]) + payload
    data += sha256d(data)[:4]
    n = int.from_bytes(data, "big")
    out = ""
    while n:
        n, rem = divmod(n, 58)
        out = B58[rem] + out
    return "1" * (len(data) - len(data.lstrip(b"\0"))) + out


def address(script):
    if len(script) == 25 and script[:3] == b"\x76\xa9\x14" and script[23:] == b"\x88\xac":
        return b58check(0x1E, script[3:23])  # P2PKH, starts with D
    if len(script) == 23 and script[:2] == b"\xa9\x14" and script[22] == 0x87:
        return b58check(0x16, script[2:22])  # P2SH, starts with 9 or A
    if len(script) in (35, 67) and script[-1] == 0xAC:
        return b58check(0x1E, hashlib.new("ripemd160", hashlib.sha256(script[1:-1]).digest()).digest())  # P2PK
    if script[:1] == b"\x6a":
        return "OP_RETURN"
    return None


# ---------- verified addresses: organisations that help animals and accept donations in DOGE ----------
# The explorer marks these addresses wherever they appear in a transaction, and lists them on /verified (and as JSON on /api/v1/verified-addresses).
# Add an organisation only after checking the address on the organisation's own website (or its official channel) and writing that page down in "source":
# anyone will send DOGE to what is listed here. An entry whose address is not a valid Dogecoin address is left out (the log says so).
#
#   {"address": "D...", "name": "Name of the organisation", "category": "Animal shelter",
#    "about": "what it does for animals", "url": "https://its-own-website.example",
#    "source": "https://its-own-website.example/donate (the page that publishes this address)", "verified": "2026-10-14",
#    "streams": [{"title": "Packing line: vegan dog food", "url": "https://www.youtube.com/watch?v=VIDEO_ID"}]},      # "streams" is optional: a livestream of the organisation's own logistics
# A stream link may be a YouTube video or channel, a Vimeo video, a Twitch channel or a direct https .m3u8 / .mp4 / .webm file; it only starts when the visitor presses play.
VERIFIED_ADDRESSES = [
]


def valid_address(a):
    n = 0
    for ch in a:
        i = B58.find(ch)
        if i < 0:
            return False
        n = n * 58 + i
    try:
        raw = n.to_bytes(25, "big")
    except OverflowError:
        return False
    return raw[0] in (0x1E, 0x16) and sha256d(raw[:21])[:4] == raw[21:]


def stream_embed(url):
    """(kind, src) to play a livestream link inside the page, or (None, url) when it can only be opened on its own site. Only https links."""
    m = re.fullmatch(r"https://([a-z0-9.-]+)(/[^\s\"'<>]*)?", url, re.I)
    if not m:
        return None, ""
    host, path = m.group(1).lower(), m.group(2) or "/"
    host = host[4:] if host.startswith("www.") else host
    q = dict(x.split("=", 1) for x in url.partition("?")[2].split("&") if "=" in x)
    if host in ("youtube.com", "m.youtube.com", "youtu.be", "youtube-nocookie.com"):
        vid = q.get("v") if path.startswith("/watch") else (path.split("/")[1] if host == "youtu.be" else (path.split("/")[2] if re.match(r"/(live|embed|shorts)/", path) else None))
        if vid and re.fullmatch(r"[\w-]{6,20}", vid):
            return "iframe", "https://www.youtube-nocookie.com/embed/" + vid + "?autoplay=1&rel=0"
        c = re.match(r"/channel/(UC[\w-]{20,24})", path)
        if c:
            return "iframe", "https://www.youtube-nocookie.com/embed/live_stream?channel=" + c.group(1) + "&autoplay=1&rel=0"
        return None, url
    if host in ("vimeo.com", "player.vimeo.com"):
        e = re.match(r"/event/(\d+)", path)
        if e:
            return "iframe", "https://vimeo.com/event/" + e.group(1) + "/embed?autoplay=1"
        v = re.search(r"/(\d{5,12})(?:/|$)", path)
        if v:
            return "iframe", "https://player.vimeo.com/video/" + v.group(1) + "?autoplay=1"
        return None, url
    if host == "twitch.tv":
        c = re.match(r"/([A-Za-z0-9_]{3,25})/?$", path)
        if c:
            return "iframe", "https://player.twitch.tv/?channel=" + c.group(1) + "&parent={host}&autoplay=true"
        return None, url
    if re.search(r"\.(m3u8|mp4|webm)$", path.partition("?")[0], re.I):
        return "video", url
    return None, url


def load_streams(raw):
    out = []
    for x in (raw if isinstance(raw, list) else []):
        u = str((x or {}).get("url", "")).strip()
        kind, src = stream_embed(u)
        if not u.lower().startswith("https://") or not src and not kind:
            log("livestream skipped (needs a https link): " + u[:60])
            continue
        out.append({"title": str((x or {}).get("title") or "Livestream"), "url": u, "kind": kind or "link", "src": src if kind else u})
    return out


def load_verified(entries):
    out = {}
    for e in entries:
        a = str(e.get("address", "")).strip()
        if not valid_address(a) or not e.get("name"):
            log("verified address skipped (not a valid Dogecoin address or no name): " + a[:40])
            continue
        out[a] = {"address": a, "name": str(e["name"]), "category": str(e.get("category") or "Animal welfare"), "about": str(e.get("about") or ""),
                  "url": str(e.get("url") or ""), "source": str(e.get("source") or ""), "verified": str(e.get("verified") or ""),
                  "streams": load_streams(e.get("streams"))}
    return out


VERIFIED = load_verified(VERIFIED_ADDRESSES)


# ---------- who sends: the address behind an input, from the unlocking script itself (no txindex needed) ----------
# A spend of a P2PKH output carries <signature> <public key>: hash160 of that key is the sender's address. A spend of a P2SH output ends with the
# redeem script: hash160 of it is the P2SH address. (A pay-to-public-key spend carries only a signature, so its address needs the previous output.)

def hash160(b):
    try:
        return hashlib.new("ripemd160", hashlib.sha256(b).digest()).digest()
    except ValueError:  # no RIPEMD-160 in this OpenSSL build
        return None


def script_pushes(script):
    out, i = [], 0
    while i < len(script):
        op = script[i]
        i += 1
        if op == 0:
            out.append(b"")
            continue
        if op <= 75:
            n = op
        elif op in (0x4C, 0x4D, 0x4E):
            ln = {0x4C: 1, 0x4D: 2, 0x4E: 4}[op]
            if i + ln > len(script):
                break
            n = int.from_bytes(script[i:i + ln], "little")
            i += ln
        else:
            continue
        if i + n > len(script):
            break
        out.append(script[i:i + n])
        i += n
    return out


def sender_address(script):
    pushes = script_pushes(script)
    if len(pushes) < 2:
        return None
    last, before = pushes[-1], pushes[-2]
    if len(last) in (33, 65) and last[:1] in (b"\x02", b"\x03", b"\x04") and before[:1] == b"\x30":
        h = hash160(last)
        return b58check(0x1E, h) if h else None
    if len(last) >= 3 and (before[:1] == b"\x30" or before == b""):
        h = hash160(last)
        return b58check(0x16, h) if h else None
    return None


# ---------- who mined it: the pool's tag in the coinbase (of the parent chain, for merge-mined blocks) ----------

POOLS = [
    ("ViaBTC", r"viabtc"), ("F2Pool", r"f2pool|七彩神仙鱼"), ("AntPool", r"antpool"), ("LitecoinPool.org", r"litecoinpool"),
    ("Binance Pool", r"binance"), ("Poolin", r"poolin"), ("Trustpool", r"trustpool"), ("Mining-Dutch", r"mining-dutch"),
    ("ZPool", r"zpool"), ("Prohashing", r"prohashing"), ("EMCDPool", r"emcd"), ("Unmineable", r"unmineable"),
    ("Hashcity", r"hashcity"), ("K1Pool", r"k1pool"), ("NiceHash", r"nicehash"), ("DxPool", r"dxpool"),
]


def pool_name(block):
    texts = []
    for tx in (block["parent_coinbase"], block["txs"][0] if block["txs"] else None):
        if tx and tx["vin"]:
            texts.append(tx["vin"][0]["script"].decode("latin-1"))
    text = " ".join(texts)
    for name, pattern in POOLS:
        if re.search(pattern, text, re.I):
            return name
    # drop the merged-mining commitment (fabe6d6d "mm" + 32-byte hash + size + nonce), then keep plain ASCII text only
    text = re.sub("\xfa\xbemm.{40}", " ", text, flags=re.S)
    tags = [t.strip("/ .-") for t in re.findall(r"[/A-Za-z0-9.\- ]{5,}", text)]
    tags = [t for t in tags if len(re.findall(r"[A-Za-z]", t)) >= 3]
    tag = max(tags, key=len) if tags else ""
    return tag[:24] if len(tag) >= 4 else "Unknown"


# ---------- blocks (cached) and the mempool ----------

_blocks = {}
_lock = threading.Lock()


def block_by_hash(h):
    with _lock:
        if h in _blocks:
            return _blocks[h]
    info = rpc("getblock", h, True)
    parsed = parse_block(rpc("getblock", h, False))
    cb = parsed["txs"][0]
    fees = max(0, sum(o["value"] for o in cb["vout"]) - SUBSIDY) if info["height"] >= 600_000 else 0
    rest = max(1, info["size"] - 80 - cb["size"])
    avg = fees / rest
    b = {"hash": h, "height": info["height"], "time": info["time"], "size": info["size"], "nTx": len(parsed["txs"]),
         "fees": fees, "avgFee": avg, "pool": pool_name(parsed), "txs": parsed["txs"], "prev": info.get("previousblockhash"),
         "next": info.get("nextblockhash"), "difficulty": info.get("difficulty"), "confirmations": info.get("confirmations"),
         "coinbaseHex": cb["vin"][0]["script"].hex()}
    with _lock:
        _blocks[h] = b
        if len(_blocks) > 300:
            for k in list(_blocks)[:100]:
                del _blocks[k]
    return b


def last_blocks(n=10):
    tip = rpc("getblockcount")
    out = []
    h = rpc("getblockhash", tip)
    while h and len(out) < n:
        b = block_by_hash(h)
        out.append(b)
        h = b["prev"]
    return out


def mempool_blocks():
    pool = rpc("getrawmempool", True)
    txs = sorted(((v["fee"] * COIN / max(1, v["size"]), v["size"], v["fee"] * COIN) for v in pool.values()), reverse=True)
    blocks, cur, size = [], [], 0
    for t in txs:
        if size + t[1] > MAX_BLOCK and cur and len(blocks) < 7:
            blocks.append((cur, size))
            cur, size = [], 0
        cur.append(t)
        size += t[1]
    if cur or not blocks:
        blocks.append((cur, size))
    out = []
    for cur, size in blocks[:8]:
        rates = sorted(t[0] for t in cur)
        pick = lambda q: round(rates[min(len(rates) - 1, int(q * len(rates)))], 2) if rates else 0
        out.append({"blockSize": size, "blockVSize": size, "nTx": len(cur), "totalFees": round(sum(t[2] for t in cur)),
                    "medianFee": pick(0.5), "feeRange": [pick(0), pick(0.1), pick(0.25), pick(0.5), pick(0.75), pick(0.9), round(rates[-1], 2) if rates else 0]})
    return out


def mempool_top(n=8):
    """the transactions that head the block being mined: best fee rate first (the site's Coinbase & Merkle Root animation hashes these)"""
    pool = rpc("getrawmempool", True)
    best = sorted(pool.items(), key=lambda kv: kv[1]["fee"] / max(1, kv[1]["size"]), reverse=True)[:n]
    return {"height": int(rpc("getblockcount")) + 1, "nTx": len(pool),
            "txs": [{"txid": k, "size": v["size"], "fee": round(v["fee"] * COIN)} for k, v in best]}


def mempool_json(b):
    """a block in mempool's /api/v1/blocks format"""
    r = round(b["avgFee"], 2)
    return {"id": b["hash"], "height": b["height"], "timestamp": b["time"], "tx_count": b["nTx"], "size": b["size"], "weight": b["size"] * 4,
            "previousblockhash": b["prev"], "extras": {"medianFee": r, "feeRange": [r, r], "totalFees": b["fees"], "reward": b["fees"] + SUBSIDY,
                                                      "pool": {"name": b["pool"]}, "coinbaseRaw": b["coinbaseHex"]}}


PERIOD_BLOCKS = 1440          # Dogecoin sets its difficulty at every block (DigiShield): the blockchain on hashes.space goes back a day, the window the pool pages use


def period_blocks(frm, limit=15, budget=8.0):
    """up to `limit` blocks from height `frm` downward, never further back than PERIOD_BLOCKS from the tip, in mempool's block format"""
    tip = int(rpc("getblockcount"))
    start = max(1, tip - PERIOD_BLOCKS + 1)
    deadline, out, h = time.time() + budget, [], min(frm, tip)
    while h >= start and len(out) < limit and (not out or time.time() < deadline):
        try:
            v = mempool_json(block_by_hash(rpc("getblockhash", h)))
            v.pop("previousblockhash", None)
            out.append(v)
        except Exception:  # noqa: BLE001
            pass
        h -= 1
    return {"tip": tip, "periodStart": start, "blocks": out}


# ---------- the next block: when it is expected ----------
# Blocks are found by chance (every hash is an independent try), so no node can know the moment; the average wait is what can be worked out, and the
# better the pace of the miners is known, the better that average is. It is estimated from several things together:
#   1. the real pace of the miners: the hashes the last blocks took, over the time they took, the newest counting most (the weight halves every NEXT_HALF blocks)
#      and the block timestamps taken end to end, so one block with a wrong clock does no harm
#   2. the difficulty of the block that is being mined now (not the last one's): at a Bitcoin retarget it follows from the period's pace, on a chain that
#      retargets every block it is the node's own number for the next block
#   3. the chain's target, as a limit: an average outside a tenth to ten times the target is not believed
# The block that comes next takes `w_next` hashes at that pace, so the average wait is w_next / pace. The error of the pace shrinks with the blocks that count.
def next_block_estimate(blocks, w_next, half):
    """blocks: [(time, hashes the block took)], oldest first. Returns (average wait in seconds, relative error, blocks that count) or None."""
    num = den = wsum = w2 = 0.0
    n = len(blocks)
    for j in range(1, n):
        wt = 0.5 ** ((n - 1 - j) / half)
        num += wt * blocks[j][1]
        den += wt * (blocks[j][0] - blocks[j - 1][0])
        wsum += wt
        w2 += wt * wt
    if num <= 0 or den <= 0 or w_next <= 0:
        return None
    n_eff = wsum * wsum / w2 if w2 else 0.0
    return w_next / (num / den), (1 / math.sqrt(n_eff) if n_eff > 0 else 1.0), n_eff


def next_block_answer(chain, tip, last_time, mean, err, n_eff, window, target, change, retarget):
    mean = max(target / 10.0, min(target * 10.0, mean))
    return {"chain": chain, "tip": tip, "lastBlockTime": last_time, "targetSeconds": target, "meanSeconds": round(mean, 1),
            "medianSeconds": round(mean * 0.6931, 1), "relativeError": round(err, 3), "blocksCounted": int(n_eff), "windowBlocks": window,
            "nextDifficultyChange": round(change, 2), "retargetNext": retarget, "updated": int(time.time())}



NEXT_WINDOW, NEXT_HALF, TARGET_SECONDS = 480, 120.0, 60       # eight hours of blocks looked at; the weight of a block halves every 120 blocks
_next_heads = {}                                              # height -> (time, difficulty, bits)
_next = {"at": 0.0, "data": None}
_next_lock = threading.Lock()


def bits_target(bits):
    return int(bits[2:], 16) * 256 ** (int(bits[:2], 16) - 3)


def next_block():
    with _next_lock:
        if _next["data"] and time.time() - _next["at"] < 15:
            return _next["data"]
        tip = int(rpc("getblockcount"))
        first = max(1, tip - NEXT_WINDOW + 1)
        todo = [h for h in range(first, tip + 1) if h not in _next_heads]
        for i in range(0, len(todo), 250):
            chunk = todo[i:i + 250]
            hashes = rpc_batch([("getblockhash", [h]) for h in chunk])
            heads = rpc_batch([("getblockheader", [bh]) for bh in hashes if bh])
            for hd in heads:
                if hd:
                    _next_heads[hd["height"]] = (int(hd["time"]), float(hd["difficulty"]), hd["bits"])
        for h in [h for h in _next_heads if h < first]:
            del _next_heads[h]
        rows = [_next_heads[h] for h in range(first, tip + 1) if h in _next_heads]
        if len(rows) < 10:
            raise RuntimeError("not enough blocks to tell")
        blocks = [(r[0], r[1]) for r in rows]
        w_tip = w_next = rows[-1][1]
        try:             # DigiShield sets the next difficulty from the last blocks: the node's own template names it (its bits)
            nb = rpc("getblocktemplate", {}, timeout=10)["bits"]
            w_next = w_tip * bits_target(rows[-1][2]) / bits_target(nb)
        except Exception:  # noqa: BLE001
            pass
        est = next_block_estimate(blocks, w_next, NEXT_HALF)
        if not est:
            raise RuntimeError("not enough blocks to tell")
        out = next_block_answer("dogecoin", tip, rows[-1][0], est[0], est[1], est[2], len(blocks), TARGET_SECONDS, (w_next / w_tip - 1) * 100, False)
        _next["at"], _next["data"] = time.time(), out
        return out


# ---------- mining statistics from your own node (mempool's /api/v1/mining format) ----------

DAY, WEEK, YEAR_DAYS = 1440, 10080, 365  # Dogecoin: a block a minute
_pool_by_height = {}
_mining = {"hashrate": {}, "pools": {}, "pool-hashrate": {}, "solo": {}, "at": 0}
# the periods the page offers: blocks in the period, and one hashrate point per STEP blocks (a block a minute)
RANGES = {"24h": (1440, 60), "14d": (20160, 360), "1m": (43200, 720), "6m": (259200, 1440), "1y": (525600, 1440)}
SAMPLE = 2500   # a long period reads about this many blocks for its pool shares (an estimate), a short one reads them all


def pool_from_header(header_hex):
    """the pool tag, from a block header: merge-mined headers carry the parent chain's coinbase (AuxPoW)"""
    r = Reader(bytes.fromhex(header_hex))
    version = r.i32()
    r.take(76)
    if version & 0x100 and r.i < len(r.d):
        return pool_name({"parent_coinbase": read_tx(r), "txs": []})
    return None


def pools_last_week(tip):
    first = max(0, tip - WEEK + 1)
    todo = [h for h in range(first, tip + 1) if h not in _pool_by_height]
    for i in range(0, len(todo), 250):
        chunk = todo[i:i + 250]
        pairs = [(h, bh) for h, bh in zip(chunk, rpc_batch([("getblockhash", [h]) for h in chunk])) if bh]
        headers = rpc_batch([("getblockheader", [bh, False]) for _, bh in pairs])
        for (h, bh), hx in zip(pairs, headers):
            name = None
            try:
                name = pool_from_header(hx) if hx else None
                if name is None:  # not merge-mined: the pool tag is in the block's own coinbase
                    name = pool_name(parse_block(rpc("getblock", bh, False)))
            except (ValueError, RpcError, KeyError, IndexError):
                name = "Unknown"
            _pool_by_height[h] = name
    for h in [h for h in _pool_by_height if h < first]:
        del _pool_by_height[h]
    counts = {}
    for h in range(first, tip + 1):
        if h in _pool_by_height:
            counts[_pool_by_height[h]] = counts.get(_pool_by_height[h], 0) + 1
    ranked = sorted(counts.items(), key=lambda kv: -kv[1])
    total = sum(counts.values())
    return {"pools": [{"poolId": i + 1, "name": n, "slug": re.sub(r"[^a-z0-9]", "", n.lower()), "rank": i + 1, "blockCount": c, "emptyBlocks": 0}
                      for i, (n, c) in enumerate(ranked)],
            "blockCount": total, "lastEstimatedHashrate": rpc("getnetworkhashps", DAY)}


def pools_range(tip, rng):
    """the pool shares of one period: every block of a short one, an evenly spread sample of a long one (scaled up)"""
    blocks = RANGES[rng][0]
    first = max(1, tip - blocks + 1)
    stride = max(1, blocks // SAMPLE)
    heights = [h for h in range(first, tip + 1) if h % stride == 0]
    todo = [h for h in heights if h not in _pool_by_height]
    for i in range(0, len(todo), 250):
        chunk = todo[i:i + 250]
        pairs = [(h, bh) for h, bh in zip(chunk, rpc_batch([("getblockhash", [h]) for h in chunk])) if bh]
        headers = rpc_batch([("getblockheader", [bh, False]) for _, bh in pairs])
        for (h, bh), hx in zip(pairs, headers):
            name = None
            try:
                name = pool_from_header(hx) if hx else None
                if name is None:
                    name = pool_name(parse_block(rpc("getblock", bh, False)))
            except (ValueError, RpcError, KeyError, IndexError):
                name = "Unknown"
            _pool_by_height[h] = name
    counts = {}
    for h in heights:
        if h in _pool_by_height:
            counts[_pool_by_height[h]] = counts.get(_pool_by_height[h], 0) + 1
    seen = sum(counts.values()) or 1
    scale = (tip - first + 1) / seen          # 1 when every block was read
    ranked = sorted(counts.items(), key=lambda kv: -kv[1])
    return {"pools": [{"poolId": i + 1, "name": n, "slug": re.sub(r"[^a-z0-9]", "", n.lower()), "rank": i + 1, "blockCount": max(1, round(c * scale)), "emptyBlocks": 0}
                      for i, (n, c) in enumerate(ranked)],
            "blockCount": tip - first + 1, "sampled": stride > 1, "lastEstimatedHashrate": rpc("getnetworkhashps", DAY)}


_pool_block_cache = {}
_pool_fill_lock = threading.Lock()
_pool_warm_lock = threading.Lock()


def _fill_pool_cache(heights):
    """read the blocks of these heights into the cache, 50 at a time (one at a time overall)"""
    if not _pool_fill_lock.acquire(blocking=False):
        return
    try:
        todo = [h for h in heights if h not in _pool_block_cache]
        for i in range(0, len(todo), 50):
            chunk = todo[i:i + 50]
            try:
                hashes = rpc_batch([("getblockhash", [h]) for h in chunk])
                blocks = rpc_batch([("getblock", [bh, True]) for bh in hashes if bh])
            except Exception as exc:  # noqa: BLE001
                log("pool blocks: " + str(exc))
                continue
            by_hash = {b["hash"]: b for b in blocks if b}
            for h, bh in zip(chunk, hashes):
                b = by_hash.get(bh)
                if b:
                    _pool_block_cache[h] = {"id": bh, "height": h, "timestamp": b["time"], "tx_count": len(b["tx"]), "size": b["size"], "weight": b["size"] * 4,
                                            "previousblockhash": b.get("previousblockhash")}
            if not by_hash:
                log("pool blocks: the node returned no block for heights " + str(chunk[0]) + "-" + str(chunk[-1]))
    finally:
        _pool_fill_lock.release()


def pool_blocks(slug):
    """the blocks one pool mined in the last 1,440 blocks (a day), newest first, in mempool's /api/v1/blocks format: the pool page on hashes.space draws them.
    The blocks are read in the background; what is ready is answered at once (the page asks again while the list grows)"""
    tip = int(rpc("getblockcount"))
    first = tip - DAY + 1
    if sum(1 for h in range(first, tip + 1) if h in _pool_by_height) < DAY // 2 and _pool_warm_lock.acquire(blocking=False):     # cold start: read the pool tags of the day now
        def warm():
            try:
                pools_range(tip, "24h")
            except Exception as exc:  # noqa: BLE001
                log("pool tags: " + str(exc))
            finally:
                _pool_warm_lock.release()
        threading.Thread(target=warm, daemon=True).start()
    heights = sorted((h for h, n in list(_pool_by_height.items()) if h >= first and re.sub(r"[^a-z0-9]", "", n.lower()) == slug), reverse=True)[:600]
    if any(h not in _pool_block_cache for h in heights):
        t = threading.Thread(target=_fill_pool_cache, args=(heights,), daemon=True)
        t.start()
        t.join(5)
    for h in [h for h in list(_pool_block_cache) if h < first]:
        _pool_block_cache.pop(h, None)
    return [dict(_pool_block_cache[h], extras={"pool": {"name": _pool_by_height[h]}}) for h in heights if h in _pool_block_cache]


def hashrate_range(tip, rng):
    blocks, step = RANGES[rng]
    n = blocks // step
    heights = [tip - d * step for d in range(n) if tip - d * step > step][::-1]
    hashes = rpc_batch([("getblockhash", [h]) for h in heights])
    headers = rpc_batch([("getblockheader", [bh]) for bh in hashes if bh])
    rates = rpc_batch([("getnetworkhashps", [step, h]) for h in heights])
    by_height = {hd["height"]: hd for hd in headers if hd}
    points, diffs, prev = [], [], None
    for h, rate in zip(heights, rates):
        hd = by_height.get(h)
        if not hd or rate is None:
            continue
        points.append({"timestamp": hd["time"], "avgHashrate": rate})
        d = hd["difficulty"]
        diffs.append({"time": hd["time"], "height": h, "difficulty": d, "adjustment": (d / prev) if prev else 1})
        prev = d
    return {"hashrates": points, "difficulty": diffs, "currentHashrate": rpc("getnetworkhashps", WEEK), "currentDifficulty": rpc("getdifficulty")}


def pool_hashrate_range(tip, rng, hr):
    """the hashrate of the pools together: the network's hashrate at each point times the share of the blocks around it that pools mined
    (the blocks read for the pool shares: all of them for a short period, an evenly spread sample for a long one)"""
    blocks, step = RANGES[rng]
    first = max(1, tip - blocks + 1)
    stride = max(1, blocks // SAMPLE)
    reach = max(step, blocks // 52)                 # each point looks back over about a fiftieth of the period
    sample = {h: _pool_by_height[h] for h in range(first, tip + 1) if h % stride == 0 and h in _pool_by_height}
    at = {d["time"]: d["height"] for d in hr["difficulty"]}
    points = []
    for pt in hr["hashrates"]:
        h = at.get(pt["timestamp"])
        if h is None:
            continue
        names = [n for k, n in sample.items() if h - reach < k <= h]
        if names:
            share = sum(1 for n in names if n != "Unknown") / len(names)
            points.append({"timestamp": pt["timestamp"], "avgHashrate": pt["avgHashrate"] * share, "share": share, "networkHashrate": pt["avgHashrate"]})
    if not points:
        raise RuntimeError("no data yet")
    names = [n for k, n in sample.items() if k > tip - max(step, WEEK)]
    now = sum(1 for n in names if n != "Unknown") / len(names) if names else points[-1]["share"]
    return {"currentHashrate": hr["currentHashrate"] * now, "currentShare": now, "networkHashrate": hr["currentHashrate"], "complete": True,
            "sampled": stride > 1, "hashrates": points}


def solo_range(pools, hr):
    """the hashrate of miners without a pool: the blocks whose coinbase names none of the known pools (a solo miner's own tag, or no tag at all)
    plus any name that says solo, times the network's hashrate. An upper bound: a pool missing from the list lands here too."""
    known = {n for n, _ in POOLS}
    total = max(1, pools["blockCount"])
    sources, other = [], 0
    for e in pools["pools"]:
        if e["name"] in known:
            continue
        if re.search("solo", e["name"], re.I):
            sources.append({"name": e["name"], "kind": "service", "blockCount": e["blockCount"]})
        else:
            other += e["blockCount"]
    if other:
        sources.append({"name": "No known pool in the coinbase", "kind": "unattributed", "blockCount": other})
    rate = hr["currentHashrate"]
    for x in sources:
        x["share"] = x["blockCount"] / total
        x["hashrate"] = rate * x["share"]
    blocks = sum(x["blockCount"] for x in sources)
    return {"window": None, "blockCount": pools["blockCount"], "soloBlocks": blocks, "share": blocks / total, "currentHashrate": rate * blocks / total,
            "networkHashrate": rate, "sampled": bool(pools.get("sampled")), "sources": sources}


def hashrate_year(tip):
    heights = [tip - d * DAY for d in range(YEAR_DAYS) if tip - d * DAY > DAY][::-1]
    hashes = rpc_batch([("getblockhash", [h]) for h in heights])
    headers = rpc_batch([("getblockheader", [bh]) for bh in hashes if bh])
    rates = rpc_batch([("getnetworkhashps", [DAY, h]) for h in heights])
    by_height = {hd["height"]: hd for hd in headers if hd}
    points, diffs, prev = [], [], None
    for h, rate in zip(heights, rates):
        hd = by_height.get(h)
        if not hd or rate is None:
            continue
        points.append({"timestamp": hd["time"], "avgHashrate": rate})
        d = hd["difficulty"]
        diffs.append({"time": hd["time"], "height": h, "difficulty": d, "adjustment": (d / prev) if prev else 1})
        prev = d
    return {"hashrates": points, "difficulty": diffs, "currentHashrate": rpc("getnetworkhashps", WEEK), "currentDifficulty": rpc("getdifficulty")}


# ---------- DigiShield: the hashrate of every block ----------
# Dogecoin retargets its difficulty at EVERY block (DigiShield, aiming at a minute per block), so there is no difficulty period to count blocks in.
# A block's difficulty says how many hashes it took: difficulty * 2^32, over the 60 s the retarget aims at: that is the hashrate of the block.
# The window is the last DIGI_BLOCKS blocks. The median of their hashrates is the network's per-block hashrate; a source's hashrate is its share
# of the window's blocks times that median (one lucky hour does not move it). The chart is the same, in slices of DIGI_SLICE blocks.
DIGI_BLOCKS, DIGI_SLICE, DIGI_TARGET = 1440, 30, 60
_diff_by_height = {}


def _median(xs):
    xs = sorted(xs)
    n = len(xs)
    return 0 if not n else xs[n // 2] if n % 2 else (xs[n // 2 - 1] + xs[n // 2]) / 2


def digishield(tip):
    first = max(1, tip - DIGI_BLOCKS + 1)
    pools_range(tip, "24h")                       # makes sure every block of the window has its pool tag
    todo = [h for h in range(first, tip + 1) if h not in _diff_by_height]
    for i in range(0, len(todo), 250):
        chunk = todo[i:i + 250]
        pairs = [(h, bh) for h, bh in zip(chunk, rpc_batch([("getblockhash", [h]) for h in chunk])) if bh]
        for (h, _), hd in zip(pairs, rpc_batch([("getblockheader", [bh]) for _, bh in pairs])):
            if hd:
                _diff_by_height[h] = (hd["difficulty"], hd["time"])
    for h in [h for h in _diff_by_height if h < first]:
        del _diff_by_height[h]
    heights = [h for h in range(first, tip + 1) if h in _diff_by_height and h in _pool_by_height]
    if len(heights) < DIGI_SLICE:
        raise RuntimeError("no data yet")
    known = {n for n, _ in POOLS}

    def kind(name):                               # a known pool, a solo service, or a tag no known pool owns
        return "pool" if name in known else "service" if re.search("solo", name, re.I) else "unattributed"
    rate = {h: _diff_by_height[h][0] * 2 ** 32 / DIGI_TARGET for h in heights}      # the hashrate of every block
    med = _median(rate.values())
    blocks = len(heights)
    names = {}
    for h in heights:
        names[_pool_by_height[h]] = names.get(_pool_by_height[h], 0) + 1
    pool_list, sources, other, pool_blocks = [], [], 0, 0
    for i, (n, c) in enumerate(sorted(names.items(), key=lambda kv: -kv[1])):
        k = kind(n)
        pool_list.append({"poolId": i + 1, "name": n, "slug": re.sub(r"[^a-z0-9]", "", n.lower()), "rank": i + 1, "blockCount": c, "emptyBlocks": 0, "hashrate": med * c / blocks})
        if k == "service":
            sources.append({"name": n, "kind": "service", "blockCount": c, "share": c / blocks, "hashrate": med * c / blocks})
        elif k == "unattributed":
            other += c
        else:
            pool_blocks += c
    if other:
        sources.append({"name": "No known pool in the coinbase", "kind": "unattributed", "blockCount": other, "share": other / blocks, "hashrate": med * other / blocks})
    solo_blocks = sum(x["blockCount"] for x in sources)
    # the chart: slices of blocks, each with the mean hashrate of its blocks and the share the pools mined
    slices = [heights[i:i + DIGI_SLICE] for i in range(0, len(heights), DIGI_SLICE)]
    slices = [sl for sl in slices if len(sl) >= DIGI_SLICE // 2]
    stamps = [_diff_by_height[sl[-1]][1] for sl in slices]
    net = [sum(rate[h] for h in sl) / len(sl) for sl in slices]
    shares = [sum(1 for h in sl if kind(_pool_by_height[h]) == "pool") / len(sl) for sl in slices]
    base = {"window": "blocks", "perBlock": True, "retarget": "DigiShield", "blockCount": blocks, "sliceBlocks": DIGI_SLICE, "slices": len(slices), "sinceBlock": heights[0], "tipBlock": heights[-1]}
    hashrate = {"hashrates": [{"timestamp": t, "avgHashrate": r} for t, r in zip(stamps, net)],
                "difficulty": [{"time": t, "height": sl[-1], "difficulty": _diff_by_height[sl[-1]][0],
                                "adjustment": (_diff_by_height[sl[-1]][0] / _diff_by_height[slices[j - 1][-1]][0]) if j else 1} for j, (t, sl) in enumerate(zip(stamps, slices))],
                "currentHashrate": med, "currentDifficulty": rpc("getdifficulty"), **base}
    pools = {"pools": pool_list, "sampled": False, "lastEstimatedHashrate": med, **base}
    pool_hr = {"currentHashrate": med * pool_blocks / blocks, "currentShare": pool_blocks / blocks, "networkHashrate": med, "complete": True, "sampled": False,
               "hashrates": [{"timestamp": t, "avgHashrate": r * s, "share": s, "networkHashrate": r} for t, r, s in zip(stamps, net, shares)], **base}
    solo = {"soloBlocks": solo_blocks, "share": solo_blocks / blocks, "currentHashrate": med * solo_blocks / blocks, "networkHashrate": med, "sampled": False, "sources": sources, **base}
    return hashrate, pools, pool_hr, solo


def mining_stats():
    """recomputed every 10 minutes in the background (the first run reads a week of block headers)"""
    while True:
        try:
            tip = rpc("getblockcount")
            _mining["pools"]["24h"] = pools_range(tip, "24h")        # the last day first: the pool profiles on hashes.space list a pool's blocks of the day
            _mining["pools"]["1w"] = pools_last_week(tip)
            _mining["hashrate"]["1y"] = hashrate_year(tip)
            _mining["at"] = time.time()
            (_mining["hashrate"]["blocks"], _mining["pools"]["blocks"], _mining["pool-hashrate"]["blocks"], _mining["solo"]["blocks"]) = digishield(tip)
            for rng in RANGES:          # the other periods follow, one by one (the long ones read more blocks)
                _mining["hashrate"][rng] = hashrate_range(tip, rng)
                _mining["pools"][rng] = pools_range(tip, rng)
                _mining["pool-hashrate"][rng] = pool_hashrate_range(tip, rng, _mining["hashrate"][rng])
                _mining["solo"][rng] = dict(solo_range(_mining["pools"][rng], _mining["hashrate"][rng]), window=rng)
        except Exception as exc:  # noqa: BLE001
            log("mining stats: " + str(exc))
        time.sleep(600)


# ---------- WebSocket (mempool protocol) ----------

_clients = set()
_clients_lock = threading.Lock()
_state = {"tip": None, "mempool": [], "mempool_json": ""}
_send_lock = threading.Lock()


def ws_send(sock, text):
    data = text.encode()
    head = bytearray([0x81])
    if len(data) < 126:
        head.append(len(data))
    elif len(data) < 65536:
        head += bytes([126]) + struct.pack(">H", len(data))
    else:
        head += bytes([127]) + struct.pack(">Q", len(data))
    with _send_lock:
        sock.sendall(bytes(head) + data)


def broadcast(obj):
    text = json.dumps(obj)
    with _clients_lock:
        dead = []
        for c in _clients:
            try:
                ws_send(c, text)
            except OSError:
                dead.append(c)
        for c in dead:
            _clients.discard(c)


def poller():
    while True:
        try:
            tip = rpc("getbestblockhash")
            if tip != _state["tip"]:
                first = _state["tip"] is None
                _state["tip"] = tip
                if not first:
                    broadcast({"block": mempool_json(block_by_hash(tip))})
            mp = mempool_blocks()
            text = json.dumps(mp)
            if text != _state["mempool_json"]:
                _state["mempool"], _state["mempool_json"] = mp, text
                broadcast({"mempool-blocks": mp})
        except Exception as exc:  # noqa: BLE001
            log("poll: " + str(exc))
        time.sleep(6)


