"""


def page(title, body, glass=False, extra_css=""):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>" + html.escape(title) + " · Dogecoin explorer</title><style>" + CSS + (PAGES_CSS if glass else "") + (extra_css or FLOW_CSS) + "</style></head><body" + (" class=g" if glass else "") + ">"
            "<header><a class=brand href='/'>Dogecoin <span>explorer</span></a>"
            + ("" if title.startswith("Verified donation") else "<form action='/search'><input name=q placeholder='Block height, block hash or address' aria-label=Search>"
            "<button>Search</button></form>") + "</header><nav class=subnav aria-label='Explorer sections'><a href='/'" + (" class=here" if not title.startswith("Verified") else "") + ">Block explorer</a>"
            "<a class=ver href='/verified'" + (" aria-current=page" if title.startswith("Verified") else "") + ">✔ Verified donation addresses</a></nav><main>" + body + "</main>"
            "<footer>Read from your own Dogecoin Core node · hashes.space</footer></body></html>")


def doge(koinu):
    return "{:,.8f}".format(koinu / COIN).rstrip("0").rstrip(".") + " DOGE"


def ago(t):
    s = max(0, int(time.time() - t))
    return str(s) + "s ago" if s < 60 else str(s // 60) + "m ago" if s < 3600 else str(s // 3600) + "h ago" if s < 86400 else str(s // 86400) + "d ago"


def home():
    info = rpc("getblockchaininfo")
    mp = rpc("getmempoolinfo")
    blocks = last_blocks(15)
    rows = "".join(
        "<tr><td><a href='/block/" + b["hash"] + "'>" + "{:,}".format(b["height"]) + "</a></td><td class=muted>" + ago(b["time"]) + "</td><td>"
        + html.escape(b["pool"]) + "</td><td class=r>" + str(b["nTx"]) + "</td><td class=r>" + "{:,.1f}".format(b["size"] / 1000) + " kB</td><td class=r>"
        + doge(b["fees"]) + "</td></tr>" for b in blocks)
    projected = _state["mempool"] or mempool_blocks()
    prow = "".join("<tr><td>" + ("Next block" if i == 0 else "+" + str(i)) + "</td><td class=r>" + str(p["nTx"]) + "</td><td class=r>"
                   + "{:,.1f}".format(p["blockSize"] / 1000) + " kB</td><td class=r>~" + str(p["medianFee"]) + " koinu/B</td></tr>"
                   for i, p in enumerate(projected))
    sync = info.get("verificationprogress", 0)
    return page("Dogecoin", "<h1>Dogecoin</h1><div class=stats>"
                + "".join("<div class='card stat'><span class=muted>" + k + "</span><b>" + v + "</b></div>" for k, v in [
                    ("Block height", "{:,}".format(info["blocks"])), ("Mempool", "{:,} txs".format(mp["size"])),
                    ("Mempool size", "{:,.1f} kB".format(mp["bytes"] / 1000)), ("Node sync", "{:.2f}%".format(sync * 100))])
                + "</div><section class=card><h2>Verified donation addresses</h2><p style='margin:0'>Organisations that help animals and accept donations in DOGE: <a href='/verified'>see their verified addresses →</a></p></section>"
                + "<section class=card><h2>Latest blocks</h2><table><tr><th>Height</th><th>Mined</th><th>Pool</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Fees</th></tr>"
                + rows + "</table></section><section class=card><h2>Mempool, in blocks of 1 MB</h2><table><tr><th>Block</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Median fee</th></tr>"
                + prow + "</table></section>")




def block_mining(ident):
    """the pool information of one block, for the pool page on hashes.space (the same shape as the Bitcoin explorers answer): the pool, the text in the coinbase
    and every address the block reward was paid to, with the amount"""
    h = rpc("getblockhash", int(ident)) if ident.isdigit() else ident
    if not HEX64.fullmatch(h):
        raise ValueError("not a block")
    b = block_by_hash(h)
    cb = b["txs"][0]
    raw = b["coinbaseHex"]
    text = bytes.fromhex(raw).decode("latin-1")
    paid = {}
    for o in cb["vout"]:
        a = address(o["script"])
        if a and valid_address(a):
            paid[a] = paid.get(a, 0) + o["value"]
    # a pool pays its miners out in batch transactions inside the blocks it mines: every transaction that pays ten or more outputs, with each address it pays
    payouts = []
    for t in b["txs"][1:]:
        if len(t["vout"]) < 10:
            continue
        try:
            f = flow_of(t, prev_outputs([i["prev"] for i in t["vin"]]))
        except Exception:  # noqa: BLE001
            f = flow_of(t)
        outs, back = {}, {}
        for o in f["outs"]:
            a = o["addr"]
            if a and valid_address(a):
                bucket = back if o.get("change") else outs
                bucket[a] = bucket.get(a, 0) + o["value"]
        if len(outs) >= 10:
            payouts.append({"txid": t["txid"], "count": len(outs), "sats": sum(outs.values()), "change": [{"address": a, "sats": v} for a, v in back.items()],
                            "outputs": [{"address": a, "sats": v} for a, v in sorted(outs.items(), key=lambda kv: -kv[1])[:400]]})
    payouts.sort(key=lambda x: -x["count"])
    return {"id": h, "height": b["height"], "timestamp": b["time"], "pool": b["pool"], "miner": "", "payouts": payouts[:10],
            "coinbaseText": "".join(c if 32 <= ord(c) < 127 else "\u00b7" for c in text), "coinbaseRaw": raw,
            "reward": sum(o["value"] for o in cb["vout"]), "paidTo": [{"address": a, "sats": v} for a, v in paid.items()]}


def payout_card(cb):
    """every output of the block's first transaction: all the addresses the block reward was paid to (a pool can pay many), each with its amount"""
    outs = [(address(o["script"]), o["value"]) for o in cb["vout"]]
    total = sum(v for _, v in outs) or 1
    def who(a):
        return ("<a href='/address/" + a + "'>" + a + "</a>") if a and valid_address(a) else "<span class=muted>data output, no address</span>"
    rows = "".join("<div class=pay><span class='mono wrap'>" + who(a) + "</span><span class=pamt>" + doge(v)[:-5] + " <small>DOGE</small></span><span class=ppct>{:.1f}%</span></div>".format(100.0 * v / total)
                   for a, v in outs)
    return ("<section class=card><h2>Paid to (" + "{:,}".format(len(outs)) + " output" + ("" if len(outs) == 1 else "s") + ")</h2>"
            "<p class=muted style='margin:0 0 6px;font-size:12.5px'>Every address the block reward was paid to, read from the first transaction of the block.</p>"
            + rows + "</section>")


def block_page(ident):
    h = rpc("getblockhash", int(ident)) if ident.isdigit() else ident
    b = block_by_hash(h)
    def btn(href, label):
        return "<a href='/block/" + href + "'>" + label + "</a>" if href else "<span class=off>" + label + "</span>"
    conf = b["confirmations"] or 0
    head = ("<div class=bhero><h1>Block " + "{:,}".format(b["height"]) + "</h1><span class=chip>Mined by <b>" + html.escape(b["pool"]) + "</b></span>"
            "<span class=chip>" + time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(b["time"])) + " (" + ago(b["time"]) + ")</span>"
            "<span class=chip><b>" + "{:,}".format(conf) + "</b> confirmation" + ("" if conf == 1 else "s") + "</span>"
            "<div class=navbtns>" + btn(b["prev"], "← previous") + btn(b["next"], "next →") + "</div></div>"
            "<div class=bhash><div class=bhtop><small>Block hash</small><button type=button class=bhcopy onclick=\"var b=this;navigator.clipboard&&navigator.clipboard.writeText('" + h
            + "').then(function(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy'},1500)})\">Copy</button></div>"
            "<span class='mono bhv'>" + h + "</span><span class=bhn>The block's unique id: a 64-character fingerprint of its header.</span></div>")
    tiles = [("Transactions", "{:,}".format(b["nTx"]), ""), ("Fees", doge(b["fees"])[:-5], "DOGE · ~{:.0f} koinu/B".format(b["avgFee"])),
             ("Reward", doge(b["fees"] + SUBSIDY)[:-5], "DOGE · subsidy 10,000 + fees"), ("Size", "{:,} B".format(b["size"]), ""),
             ("Difficulty", "{:,.0f}".format(b["difficulty"] or 0), "")]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:18px'>" + v + "</b>" + (("<em>" + sub + "</em>") if sub else "") + "</div>" for k, v, sub in tiles)
    mining = [("Pool", html.escape(b["pool"])), ("Subsidy", doge(SUBSIDY)), ("Fees", doge(b["fees"])), ("Average fee rate", "{:.2f} koinu/B".format(b["avgFee"]))]
    gr = "<section class=card><h2>Mining</h2><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in mining) + "</dl></section>"
    gr += payout_card(b["txs"][0])
    return page("Block " + str(b["height"]), head + "<div class=tiles>" + tl + "</div><div class=groups>" + gr + "</div>", True)


def verified_page():
    def card(a, v):
        site = ("<a class=vbtn href='" + html.escape(v["url"]) + "' target=_blank rel=noopener>Website ↗</a>") if v["url"].startswith("http") else ""
        src = ("<div class=vsrc>Address published at <b>" + html.escape(re.sub(r"^https?://", "", v["source"]).rstrip("/")) + "</b></div>") if v["source"] else ""
        return ("<article class=vcard data-s='" + html.escape((v["name"] + " " + v["category"] + " " + v["about"] + " " + a).lower(), quote=True) + "'>"
                "<div class=vtop><span class=vchip>✔ Verified</span>" + ("<span class=vlive>● LIVE</span>" if v["streams"] else "") + "<span class=vcat>" + html.escape(v["category"]) + "</span></div>"
                "<h3>" + html.escape(v["name"]) + "</h3><p class=vabout>" + html.escape(v["about"]) + "</p>"
                "<div class=vaddr><span class=mono>" + a + "</span><button type=button class=vcopy data-a='" + a + "'>Copy</button></div>"
                "<div class=vfoot>" + site + (("<a class=vbtn href='/address/" + a + "#live'>▶ Watch live</a>") if v["streams"] else "") + "<a class=vbtn href='/address/" + a + "'>Address page</a>"
                + (("<span class=vdate>Verified " + html.escape(v["verified"]) + "</span>") if v["verified"] else "") + "</div>" + src + "</article>")
    cards = "".join(card(a, v) for a, v in sorted(VERIFIED.items(), key=lambda kv: kv[1]["name"].lower()))
    n = len(VERIFIED)
    body = ("<div class=bhero><h1>Verified donation addresses</h1><span class=chip><b>" + str(n) + "</b> verified</span><span class=chip>Animal welfare</span>"
            "<span class=chip>Donations in DOGE</span></div>"
            "<section class=card><h2>Organisations that help animals</h2><p class=lead style='margin:0'>Dogecoin addresses of organisations that help animals and accept donations in DOGE. "
            "Wherever one of these addresses appears in a transaction on this explorer, it is marked <span class=vchip>✔ Verified</span>, and a transaction that pays one gets its own chip.</p>"
            "<p class=muted style='margin:8px 0 0;font-size:12.5px'>An address is only listed once it has been checked against the organisation's own website. Even so, check the address on the "
            "organisation's own page before you send DOGE: a copied address cannot be taken back.</p></section>"
            + (("<form class=finder onsubmit='return false'><input id=vq placeholder='Search an organisation, what it does, or an address' aria-label='Search the verified addresses' autocomplete=off spellcheck=false></form>"
                "<div class=vgrid id=vgrid>" + cards + "</div><p class=muted id=vnone hidden style='text-align:center'>No verified address matches.</p>") if n
               else "<section class=card><h2>No address yet</h2><p class=muted style='margin:0'>No organisation is verified on this explorer yet. Verified addresses appear here, "
                    "and on every transaction that uses them, as soon as they are added.</p></section>")
            + "<script>" + VERIFIED_JS + "</script>")
    return page("Verified donation addresses", body, True, FLOW_CSS + WALLET_CSS + SHIP_CSS).replace("<main>", "<canvas id=dship aria-hidden=true></canvas><main>", 1).replace("</body>", "<script>" + SHIP_JS + "</script></body>", 1)


