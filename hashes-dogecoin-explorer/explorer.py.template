def prev_outputs(txids):
    """{txid: [(value, address), ...]} of the transactions whose outputs these inputs spend, from the node (needs -txindex, or the mempool); None where it cannot say"""
    need = [t for t in dict.fromkeys(txids) if t not in _prev]
    if need:
        try:
            res = rpc_batch([("getrawtransaction", (t, 0)) for t in need])
        except RpcError:
            res = [None] * len(need)
        if len(_prev) > 4000:
            _prev.clear()
        for t, hx in zip(need, res):
            try:
                _prev[t] = [(o["value"], address(o["script"])) for o in read_tx(Reader(bytes.fromhex(hx)))["vout"]] if hx else None
            except (ValueError, KeyError, struct.error):
                _prev[t] = None
    return {t: _prev.get(t) for t in txids}


def flow_of(tx, prev=None):
    """where the coins of one transaction go: who they come from (address, amount when the node can say), and every output with the address it pays.
    An output that pays an address that also sent is change going back to the sender."""
    outs = [{"addr": address(o["script"]), "value": o["value"], "script": o["script"].hex()} for o in tx["vout"]]
    total_out = sum(o["value"] for o in outs)
    if tx["coinbase"]:
        return {"coinbase": True, "ins": [], "outs": outs, "total_out": total_out, "total_in": None, "fee": None}
    senders, known = {}, True
    for i in tx["vin"]:
        p = (prev or {}).get(i["prev"])
        value = addr = None
        if p and i["n"] < len(p):
            value, addr = p[i["n"]]
        if not addr:
            addr = sender_address(i["script"])
        if value is None:
            known = False
        e = senders.setdefault(addr or "?", {"addr": addr, "value": 0, "known": True, "n": 0})
        e["n"] += 1
        if value is None:
            e["known"] = False
        else:
            e["value"] += value
    mine = {a for a in senders if a != "?"}
    for o in outs:
        o["change"] = bool(o["addr"]) and o["addr"] in mine
    total_in = sum(e["value"] for e in senders.values()) if known else None
    return {"coinbase": False, "ins": list(senders.values()), "outs": outs, "total_out": total_out, "total_in": total_in,
            "fee": (total_in - total_out) if total_in is not None else None}


